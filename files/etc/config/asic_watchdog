config settings 'main'
	option enabled '1'
	option interval '30'
	option api_timeout '4'
	option monitor_timeout '180'
	option telegram_timeout '12'
	option telegram_resolve_ip ''
	option fail_cycles '2'
	option alert_cooldown '3600'
	option reboot_cooldown '1800'
	option max_temp '85'
	option min_hashrate '1'
	option bad_share_percent '3'
	option bad_share_hour_percent '1'
	option hashrate_drop_percent '30'
	option hashrate_recovery_percent '85'
	option max_hw_errors_delta '100'
	option min_fan_rpm '1000'
	option auto_reboot_on_overheat '0'
	option auto_reboot_on_idle '0'
	option auto_reboot_on_bad_shares '0'
	option telegram_enabled '0'
	option bot_token ''
	option chat_id ''
	option router_label 'OpenWrt ASIC Watchdog'

