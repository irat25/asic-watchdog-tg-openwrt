#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/asic-watchdog

watchdog_pids() {
	ps w | awk '/asic-watchdog\} \/bin\/sh \/usr\/bin\/asic-watchdog (daemon|run-once)/ { print $1 }'
}

stop_watchdog_processes() {
	for pid in $(watchdog_pids); do
		kill "$pid" 2>/dev/null || true
	done
	sleep 1
	for pid in $(watchdog_pids); do
		kill -9 "$pid" 2>/dev/null || true
	done
	rm -rf /tmp/asic-watchdog/daemon.lock /tmp/asic-watchdog/daemon.pid /tmp/asic-watchdog/monitor.lock /tmp/asic-watchdog/telegram-poll.lock 2>/dev/null || true
}

start_service() {
	stop_watchdog_processes
	procd_open_instance
	procd_set_param command "$PROG" daemon
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	stop_watchdog_processes
}

reload_service() {
	stop
	start
}
