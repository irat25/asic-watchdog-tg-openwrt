#!/bin/sh

PATH=/usr/sbin:/usr/bin:/sbin:/bin

CONFIG="asic_watchdog"
RUNDIR="/tmp/asic-watchdog"
STATUS_FILE="$RUNDIR/status.json"
STATUS_TMP="$RUNDIR/status.json.tmp"
LOCK_FILE="$RUNDIR/monitor.lock"
TG_OFFSET_FILE="$RUNDIR/telegram.offset"
TG_POLL_LOCK_DIR="$RUNDIR/telegram-poll.lock"
DAEMON_PID_FILE="$RUNDIR/daemon.pid"
DAEMON_LOCK_DIR="$RUNDIR/daemon.lock"

mkdir -p "$RUNDIR"

log() {
	logger -t asic-watchdog "$*"
}

debug_enabled() {
	[ "$(cfg debug_log 1)" = "1" ]
}

log_debug() {
	debug_enabled && log "debug $*"
}

log_limited() {
	key="$(safe_id "$1")"
	interval="$2"
	shift 2
	current="$(now)"
	file="$RUNDIR/log-$key.last"
	last="$(cat "$file" 2>/dev/null || echo 0)"
	if [ $((current - last)) -ge "$interval" ]; then
		log "$*"
		echo "$current" >"$file"
	fi
}

cfg() {
	uci -q get "$CONFIG.main.$1" 2>/dev/null || printf '%s' "${2:-}"
}

section_cfg() {
	uci -q get "$CONFIG.$1.$2" 2>/dev/null || printf '%s' "${3:-}"
}

json_escape() {
	awk '{
		gsub(/\\/, "\\\\")
		gsub(/"/, "\\\"")
		gsub(/\t/, "\\t")
		gsub(/\r/, "")
		if (NR > 1) printf "\\n"
		printf "%s", $0
	}'
}

jfield() {
	printf '"%s":"%s"' "$1" "$(printf '%s' "$2" | json_escape)"
}

now() {
	date +%s
}

miner_sections() {
	uci -q show "$CONFIG" 2>/dev/null | sed -n "s/^$CONFIG\.\(@miner\[[0-9][0-9]*\]\)=miner$/\1/p"
}

camera_sections() {
	uci -q show "$CONFIG" 2>/dev/null | sed -n "s/^$CONFIG\.\(@camera\[[0-9][0-9]*\]\)=camera$/\1/p"
}

safe_id() {
	printf '%s' "$1" | sed 's/[^A-Za-z0-9_.-]/_/g'
}

num_or_zero() {
	printf '%s' "$1" | awk '
	{
		gsub(/,/, ".")
		if (match($0, /[-+]?[0-9]+([.][0-9]+)?([eE][-+]?[0-9]+)?/)) {
			print substr($0, RSTART, RLENGTH) + 0
			ok=1
			exit
		}
	}
	END { if (!ok) print 0 }'
}

ge_num() {
	awk -v a="$(num_or_zero "$1")" -v b="$(num_or_zero "$2")" 'BEGIN { exit !(a >= b) }'
}

gt_num() {
	awk -v a="$(num_or_zero "$1")" -v b="$(num_or_zero "$2")" 'BEGIN { exit !(a > b) }'
}

pct_gt() {
	awk -v a="$(num_or_zero "$1")" -v b="$(num_or_zero "$2")" 'BEGIN { exit !(a > b) }'
}

cgminer_cmd() {
	ip="$1"
	port="$2"
	command="$3"
	timeout="$(cfg api_timeout 4)"
	api_id="$(safe_id "$ip-$port-$command-$$")"
	api_in="$RUNDIR/api-$api_id.in"
	api_out="$RUNDIR/api-$api_id.out"
	api_err="$RUNDIR/api-$api_id.err"
	printf '{"command":"%s"}' "$command" >"$api_in"
	nc "$ip" "$port" <"$api_in" >"$api_out" 2>"$api_err" &
	api_pid="$!"
	api_wait=0
	while kill -0 "$api_pid" 2>/dev/null; do
		if [ "$api_wait" -ge "$timeout" ]; then
			kill "$api_pid" 2>/dev/null || true
			break
		fi
		sleep 1
		api_wait=$((api_wait + 1))
	done
	wait "$api_pid" 2>/dev/null || true
	cat "$api_out" 2>/dev/null | tr '\000' '\n'
	rm -f "$api_in" "$api_out" "$api_err"
}

field_from_text() {
	key="$1"
	tr ',|' '\n\n' | awk -v key="$key" '
	{
		line=$0
		gsub(/^[[:space:]{\[]+/, "", line)
		if (substr(line, 1, 1) == "\"")
			line=substr(line, 2)
		if (index(line, key) == 1) {
			line=substr(line, length(key) + 1)
			if (substr(line, 1, 1) == "\"")
				line=substr(line, 2)
			sub(/^[[:space:]]*[:=][[:space:]"]*/, "", line)
			sub(/[,"|}].*$/, "", line)
			print line
			exit
		}
	}'
}

first_field() {
	text="$1"
	shift
	while [ "$#" -gt 0 ]; do
		value="$(printf '%s' "$text" | field_from_text "$1")"
		[ -n "$value" ] && {
			printf '%s' "$value"
			return
		}
		shift
	done
}

append_value() {
	current="$1"
	value="$2"
	if [ -n "$current" ]; then
		printf '%s/%s' "$current" "$value"
	else
		printf '%s' "$value"
	fi
}

join_keys() {
	text="$1"
	shift
	out=""
	while [ "$#" -gt 0 ]; do
		value="$(first_field "$text" "$1")"
		if [ -n "$value" ] && [ "$value" != "0" ]; then
			out="$(append_value "$out" "$value")"
		fi
		shift
	done
	printf '%s' "$out"
}

all_field_values() {
	text="$1"
	key="$2"
	printf '%s' "$text" |
		tr ',|{}[]' '\n\n\n\n\n\n' |
		sed -n "s/^[[:space:]]*\"*$key\"*[[:space:]]*[:=][[:space:]\"']*\\([^,\"'|}]*\\).*/\\1/p" |
		awk 'NF && $1 != "0" { if (out != "") out=out "/" $1; else out=$1 } END { print out }'
}

min_from_list() {
	printf '%s' "$1" | tr '/' '\n' |
		awk 'NF && $1+0==$1 { if (!seen || $1+0 < min) min=$1+0; seen=1 } END { if (seen) print min; else print 0 }'
}

count_from_list() {
	printf '%s' "$1" | tr '/' '\n' | awk 'NF { c++ } END { print c+0 }'
}

max_temp_from_text() {
	printf '%s' "$1" |
		tr ',|{}[]' '\n\n\n\n\n\n' |
		sed -n 's/.*[Tt]emp[^:=]*[:=][^0-9-]*\([0-9][0-9.]*\).*/\1/p' |
		awk 'BEGIN { max="" } { if (max == "" || $1+0 > max+0) max=$1 } END { if (max == "") print 0; else print max+0 }'
}

hashrate_from_text() {
	text="$1"
	value="$(first_field "$text" "GHS 5s" "GHS av" "GHS RT" "MHS 5s" "MHS av" "MHS RT" "HS RT" "Hash Rate" "hashrate")"
	num_or_zero "$value"
}

accepted_from_text() {
	num_or_zero "$(first_field "$1" "Accepted" "accepted")"
}

rejected_from_text() {
	num_or_zero "$(first_field "$1" "Rejected" "rejected" "Stale")"
}

hw_errors_from_text() {
	num_or_zero "$(first_field "$1" "Hardware Errors" "Device Hardware%" "HW" "hw_errors")"
}

fan_rpm_from_text() {
	text="$1"
	fans="$(join_keys "$text" "fan1" "fan2" "fan3" "fan4" "fan5" "fan6")"
	[ -n "$fans" ] || fans="$(join_keys "$text" "Fan Speed In" "Fan Speed Out")"
	printf '%s' "$fans"
}

board_temps_from_text() {
	text="$1"
	temps="$(join_keys "$text" "temp1" "temp2" "temp3" "temp4" "temp5" "temp6" "temp7" "temp8")"
	[ -n "$temps" ] || temps="$(all_field_values "$text" "Temperature")"
	printf '%s' "$temps"
}

chip_temps_from_text() {
	text="$1"
	temps="$(join_keys "$text" "temp2_1" "temp2_2" "temp2_3" "temp2_4" "temp2_5" "temp2_6" "temp2_7" "temp2_8")"
	[ -n "$temps" ] || temps="$(all_field_values "$text" "Chip Temp Max")"
	printf '%s' "$temps"
}

board_hashrates_from_text() {
	text="$1"
	rates="$(join_keys "$text" "chain_rate1" "chain_rate2" "chain_rate3" "chain_rate4" "chain_rate5" "chain_rate6" "chain_rate7" "chain_rate8")"
	[ -n "$rates" ] || rates="$(all_field_values "$text" "MHS av")"
	printf '%s' "$rates"
}

board_chips_from_text() {
	join_keys "$1" "chain_acn1" "chain_acn2" "chain_acn3" "chain_acn4" "chain_acn5" "chain_acn6" "chain_acn7" "chain_acn8"
}

board_status_from_text() {
	join_keys "$1" "chain_acs1" "chain_acs2" "chain_acs3" "chain_acs4" "chain_acs5" "chain_acs6" "chain_acs7" "chain_acs8"
}

board_hw_from_text() {
	hw="$(join_keys "$1" "chain_hw1" "chain_hw2" "chain_hw3" "chain_hw4" "chain_hw5" "chain_hw6" "chain_hw7" "chain_hw8")"
	[ -n "$hw" ] || hw="$(all_field_values "$1" "Hardware Errors")"
	printf '%s' "$hw"
}

uptime_from_text() {
	first_field "$1" "Elapsed" "Uptime" "Up Time" "Miner Uptime"
}

autotune_from_text() {
	upfreq="$(first_field "$1" "Upfreq Complete" "upfreq_complete")"
	target_freq="$(first_field "$1" "Target Freq")"
	freq_avg="$(first_field "$1" "freq_avg")"
	[ -n "$upfreq" ] || [ -n "$target_freq$freq_avg" ] || return
	printf 'upfreq=%s target=%s avg=%s' "${upfreq:-n/a}" "${target_freq:-n/a}" "${freq_avg:-n/a}"
}

pools_from_text() {
	text="$1"
	urls="$(all_field_values "$text" "URL")"
	statuses="$(all_field_values "$text" "Status")"
	users="$(all_field_values "$text" "User")"
	[ -n "$urls$statuses$users" ] || return
	printf 'url=%s status=%s user=%s' "${urls:-n/a}" "${statuses:-n/a}" "${users:-n/a}"
}

ping_status() {
	ip="$1"
	ping -c 1 -W 1 "$ip" 2>/dev/null |
		awk -F'time=' '/time=/{ split($2,a," "); print "ok " a[1] "ms"; ok=1 } END { if (!ok) print "fail" }'
}

bad_share_percent() {
	accepted="$(num_or_zero "$1")"
	rejected="$(num_or_zero "$2")"
	awk -v a="$accepted" -v r="$rejected" 'BEGIN { total=a+r; if (total <= 0) print 0; else printf "%.2f", (r*100)/total }'
}

share_hour_stats() {
	sample_file="$1"
	current="$2"
	[ -n "$current" ] || current="$(now)"
	accepted_now="$(num_or_zero "$3")"
	rejected_now="$(num_or_zero "$4")"
	cutoff=$((current - 3600))
	tmp_file="$sample_file.tmp"
	{
		[ -f "$sample_file" ] && awk -v cutoff="$cutoff" '$1 >= cutoff { print }' "$sample_file"
		printf '%s %s %s\n' "$current" "$accepted_now" "$rejected_now"
	} >"$tmp_file"
	mv "$tmp_file" "$sample_file"
	awk '
		NR == 1 { first_t=$1; first_a=$2; first_r=$3 }
		{ last_t=$1; last_a=$2; last_r=$3 }
		END {
			elapsed=last_t-first_t
			da=last_a-first_a
			dr=last_r-first_r
			if (da < 0 || dr < 0) {
				elapsed=0
				da=0
				dr=0
			}
			total=da+dr
			pct=0
			if (total > 0) pct=(dr*100)/total
			printf "%.2f %d %.0f %.0f", pct, elapsed, da, dr
		}
	' "$sample_file"
}

seconds_of_day() {
	date '+%H %M %S' | awk '{ print ($1 * 3600) + ($2 * 60) + $3 }'
}

yesterday_ymd() {
	current="$1"
	date -d "@$((current - 86400))" '+%Y%m%d' 2>/dev/null || printf ''
}

miner_history_stats() {
	sample_file="$1"
	current="$2"
	[ -n "$current" ] || current="$(now)"
	accepted_now="$(num_or_zero "$3")"
	rejected_now="$(num_or_zero "$4")"
	hashrate_now="$(num_or_zero "$5")"
	temp_now="$(num_or_zero "$6")"
	fan_now="$(num_or_zero "$7")"
	bad_now="$(num_or_zero "$8")"
	today="$(date '+%Y%m%d')"
	yesterday="$(yesterday_ymd "$current")"
	sod="$(seconds_of_day)"
	cutoff=$((current - 172800))
	tmp_file="$sample_file.tmp"
	{
		[ -f "$sample_file" ] && awk -v cutoff="$cutoff" 'NF >= 6 && $1 >= cutoff { print }' "$sample_file"
		printf '%s %s %s %s %s %s %s %s %s\n' "$current" "$today" "$sod" "$accepted_now" "$rejected_now" "$hashrate_now" "$temp_now" "$fan_now" "$bad_now"
	} >"$tmp_file"
	mv "$tmp_file" "$sample_file"
	awk -v current="$current" -v today="$today" -v yesterday="$yesterday" -v sod="$sod" '
		{
			t=$1; ymd=$2; sample_sod=$3; acc=$4; hash=$6; temp=$7; fan=$8; bad=$9
			if (t >= current - 86400 && hash > 0) {
				hash_sum += hash
				hash_count++
				bucket = int((t - (current - 86400)) / 3600)
				if (bucket < 0) bucket = 0
				if (bucket > 23) bucket = 23
				hash_bucket_sum[bucket] += hash
				hash_bucket_count[bucket]++
			}
			if (t >= current - 86400 && temp > 0) {
				temp_sum += temp
				temp_count++
				if (!temp_max_seen || temp > temp_max) {
					temp_max = temp
					temp_max_seen = 1
				}
				bucket = int((t - (current - 86400)) / 3600)
				if (bucket < 0) bucket = 0
				if (bucket > 23) bucket = 23
				temp_bucket_sum[bucket] += temp
				temp_bucket_count[bucket]++
			}
			if (t >= current - 86400 && fan > 0) {
				if (!fan_min_seen || fan < fan_min) {
					fan_min = fan
					fan_min_seen = 1
				}
			}
			if (t >= current - 86400 && bad >= 0 && NF >= 9) {
				bad_sum += bad
				bad_count++
				if (!bad_max_seen || bad > bad_max) {
					bad_max = bad
					bad_max_seen = 1
				}
				bucket = int((t - (current - 86400)) / 3600)
				if (bucket < 0) bucket = 0
				if (bucket > 23) bucket = 23
				bad_bucket_sum[bucket] += bad
				bad_bucket_count[bucket]++
			}
			if (ymd == today) {
				if (!today_seen) {
					today_first = acc
					today_seen = 1
				}
				today_last = acc
			}
			if (yesterday != "" && ymd == yesterday) {
				if (!yday_seen) {
					yday_first = acc
					yday_seen = 1
				}
				if (sample_sod <= sod) {
					yday_last = acc
					yday_same_seen = 1
				}
			}
		}
		END {
			hash24 = 0
			if (hash_count > 0) hash24 = hash_sum / hash_count
			temp_avg = 0
			if (temp_count > 0) temp_avg = temp_sum / temp_count
			if (!temp_max_seen) temp_max = 0
			if (!fan_min_seen) fan_min = 0
			bad_avg = 0
			if (bad_count > 0) bad_avg = bad_sum / bad_count
			if (!bad_max_seen) bad_max = 0
			today_delta = 0
			if (today_seen) {
				today_delta = today_last - today_first
				if (today_delta < 0) today_delta = 0
			}
			yday_delta = 0
			if (yday_seen && yday_same_seen) {
				yday_delta = yday_last - yday_first
				if (yday_delta < 0) yday_delta = 0
			}
			pct = ""
			if (yday_delta > 0)
				pct = sprintf("%+.1f", ((today_delta - yday_delta) * 100) / yday_delta)
			hash_spark = ""
			temp_spark = ""
			bad_spark = ""
			for (i = 0; i < 24; i++) {
				sep = (i == 0 ? "" : ",")
				if (hash_bucket_count[i] > 0) hash_spark = hash_spark sep sprintf("%.0f", hash_bucket_sum[i] / hash_bucket_count[i])
				else hash_spark = hash_spark sep "0"
				if (temp_bucket_count[i] > 0) temp_spark = temp_spark sep sprintf("%.1f", temp_bucket_sum[i] / temp_bucket_count[i])
				else temp_spark = temp_spark sep "0"
				if (bad_bucket_count[i] > 0) bad_spark = bad_spark sep sprintf("%.2f", bad_bucket_sum[i] / bad_bucket_count[i])
				else bad_spark = bad_spark sep "0"
			}
			printf "%.2f|%.0f|%.0f|%s|%.1f|%.1f|%.0f|%.2f|%.2f|%s|%s|%s", hash24, today_delta, yday_delta, pct, temp_avg, temp_max, fan_min, bad_avg, bad_max, hash_spark, temp_spark, bad_spark
		}
	' "$sample_file"
}

load_miner_state() {
	state_file="$1"
	idle_count=0
	hot_count=0
	bad_count=0
	hash_drop_count=0
	last_hw=0
	last_alert=0
	last_reboot=0
	last_status="unknown"
	baseline_hashrate=0
	crit_api_down=0
	crit_fan_fault=0
	crit_hash_drop=0
	crit_bad_hour=0
	[ -f "$state_file" ] && . "$state_file" 2>/dev/null
}

save_miner_state() {
	state_file="$1"
	{
		printf 'idle_count=%s\n' "${idle_count:-0}"
		printf 'hot_count=%s\n' "${hot_count:-0}"
		printf 'bad_count=%s\n' "${bad_count:-0}"
		printf 'hash_drop_count=%s\n' "${hash_drop_count:-0}"
		printf 'last_hw=%s\n' "${hw_errors:-0}"
		printf 'last_alert=%s\n' "${last_alert:-0}"
		printf 'last_reboot=%s\n' "${last_reboot:-0}"
		printf 'baseline_hashrate=%s\n' "${baseline_hashrate:-0}"
		printf 'crit_api_down=%s\n' "${crit_api_down:-0}"
		printf 'crit_fan_fault=%s\n' "${crit_fan_fault:-0}"
		printf 'crit_hash_drop=%s\n' "${crit_hash_drop:-0}"
		printf 'crit_bad_hour=%s\n' "${crit_bad_hour:-0}"
		printf "last_status='%s'\n" "$(printf '%s' "${status:-unknown}" | sed "s/'//g")"
	} >"$state_file"
}

load_camera_state() {
	state_file="$1"
	last_status="unknown"
	last_alert=0
	[ -f "$state_file" ] && . "$state_file" 2>/dev/null
}

save_camera_state() {
	state_file="$1"
	{
		printf 'last_alert=%s\n' "${last_alert:-0}"
		printf "last_status='%s'\n" "$(printf '%s' "${status:-unknown}" | sed "s/'//g")"
	} >"$state_file"
}

telegram_ready() {
	[ "$(cfg telegram_enabled 0)" = "1" ] && [ -n "$(cfg bot_token)" ]
}

telegram_enabled() {
	telegram_ready && [ -n "$(cfg chat_id)" ]
}

telegram_timeout() {
	cfg telegram_timeout 12
}

telegram_max_candidates() {
	value="$(cfg telegram_max_candidates 2)"
	case "$value" in
		''|*[!0-9]*) value=2 ;;
	esac
	[ "$value" -lt 1 ] && value=1
	printf '%s' "$value"
}

telegram_send_retries() {
	value="$(cfg telegram_send_retries 2)"
	case "$value" in
		''|*[!0-9]*) value=2 ;;
	esac
	[ "$value" -lt 1 ] && value=1
	printf '%s' "$value"
}

telegram_resolve_candidates() {
	primary="$(cfg telegram_resolve_ip)"
	{
		[ -n "$primary" ] && printf '%s\n' "$primary"
		[ "$primary" = "dns" ] || cat "$RUNDIR/telegram.resolve_ip" 2>/dev/null || true
		cfg telegram_resolve_ips
		printf '149.154.166.110 149.154.167.99 149.154.167.50 149.154.167.220 149.154.175.100\n'
		printf 'dns\n'
	} | tr ' ,' '\n\n' | awk 'NF && !seen[$1]++ { print }'
}

telegram_note_success() {
	echo 0 >"$RUNDIR/telegram.fail_count"
}

telegram_note_failure() {
	reason="$1"
	current="$(cat "$RUNDIR/telegram.fail_count" 2>/dev/null || echo 0)"
	current=$((current + 1))
	echo "$current" >"$RUNDIR/telegram.fail_count"
	threshold="$(cfg telegram_recover_failures 3)"
	if [ "$current" -ge "$threshold" ]; then
		log_limited telegram_recover 60 "telegram unhealthy failures=$current reason=$reason, probing API"
		probe_interval="$(cfg telegram_probe_interval 300)"
		case "$probe_interval" in
			''|*[!0-9]*) probe_interval=300 ;;
		esac
		last_probe="$(cat "$RUNDIR/telegram-probe.last" 2>/dev/null || echo 0)"
		now_probe="$(now)"
		if [ $((now_probe - last_probe)) -ge "$probe_interval" ]; then
			echo "$now_probe" >"$RUNDIR/telegram-probe.last"
			telegram_probe_api >/dev/null 2>&1 || true
		else
			log_limited telegram_probe_skip 60 "telegram probe skipped age=$((now_probe - last_probe))s interval=${probe_interval}s"
		fi
		echo 0 >"$RUNDIR/telegram.fail_count"
	fi
}

telegram_probe_api() {
	telegram_ready || return 1
	resp="$(telegram_request "getMe" "" no_note)" || {
		log_limited telegram_probe_failed 60 "telegram getMe probe failed"
		return 1
	}
	case "$resp" in
		*'"ok":true'*)
			log_limited telegram_probe_ok 300 "telegram getMe probe ok"
			return 0
			;;
		*)
			log_limited telegram_probe_rejected 60 "telegram getMe probe rejected: $(printf '%s' "$resp" | cut -c1-180)"
			return 1
			;;
	esac
}

telegram_request() {
	method="$1"
	post_data="$2"
	note_mode="${3:-note}"
	token="$(cfg bot_token)"
	url="https://api.telegram.org/bot$token/$method"
	timeout="$(telegram_timeout)"
	max_candidates="$(telegram_max_candidates)"
	started="$(now)"
	if command -v curl >/dev/null 2>&1; then
		tried=0
		last_ip=""
		last_rc=""
		for resolve_ip in $(telegram_resolve_candidates); do
			tried=$((tried + 1))
			[ "$tried" -gt "$max_candidates" ] && break
			attempt_started="$(now)"
			err_file="$RUNDIR/telegram-curl-${method}-$$.err"
			if [ -n "$post_data" ]; then
				if [ "$resolve_ip" = "dns" ]; then
					resp="$(curl -sS --connect-timeout "$timeout" --max-time "$timeout" \
						-d "$post_data" "$url" 2>"$err_file")"
				else
					resp="$(curl -sS --connect-timeout "$timeout" --max-time "$timeout" \
						--resolve "api.telegram.org:443:$resolve_ip" -d "$post_data" "$url" 2>"$err_file")"
				fi
				rc=$?
			else
				if [ "$resolve_ip" = "dns" ]; then
					resp="$(curl -sS --connect-timeout "$timeout" --max-time "$timeout" \
						"$url" 2>"$err_file")"
				else
					resp="$(curl -sS --connect-timeout "$timeout" --max-time "$timeout" \
						--resolve "api.telegram.org:443:$resolve_ip" "$url" 2>"$err_file")"
				fi
				rc=$?
			fi
			duration=$(( $(now) - attempt_started ))
			if [ "$rc" -eq 0 ]; then
				rm -f "$err_file" 2>/dev/null || true
				log_debug "telegram request ok method=$method ip=$resolve_ip try=$tried duration=${duration}s bytes=${#resp}"
				case "$resp" in
					*'"ok":false'*)
						log_limited "telegram_${method}_api_false" 30 "telegram api rejected method=$method ip=$resolve_ip try=$tried duration=${duration}s response=$(printf '%s' "$resp" | cut -c1-180)"
						;;
				esac
					echo "$resolve_ip" >"$RUNDIR/telegram.resolve_ip"
					[ "$note_mode" = "note" ] && telegram_note_success
					printf '%s' "$resp"
					return 0
			fi
			last_ip="$resolve_ip"
			last_rc="$rc"
			err_text="$(cat "$err_file" 2>/dev/null | tr '\r\n' '  ' | cut -c1-160)"
			rm -f "$err_file" 2>/dev/null || true
			log_limited "telegram_${method}_${resolve_ip}_curl_fail" 30 "telegram curl failed method=$method ip=$resolve_ip try=$tried duration=${duration}s rc=$rc err=${err_text:-none}"
		done
		[ "$note_mode" = "note" ] && telegram_note_failure "$method"
		log_limited "telegram_${method}_all_failed" 30 "telegram request failed method=$method tried=$tried max_candidates=$max_candidates timeout=${timeout}s last_ip=${last_ip:-none} last_rc=${last_rc:-none} total=$(( $(now) - started ))s"
		return 1
	fi
	if [ -n "$post_data" ]; then
		resp="$(wget -T "$timeout" -qO- --post-data="$post_data" "$url" 2>/dev/null)" || {
			[ "$note_mode" = "note" ] && telegram_note_failure "$method"
			log_limited "telegram_${method}_wget_fail" 30 "telegram wget failed method=$method timeout=${timeout}s total=$(( $(now) - started ))s"
			return 1
		}
	else
		resp="$(wget -T "$timeout" -qO- "$url" 2>/dev/null)" || {
			[ "$note_mode" = "note" ] && telegram_note_failure "$method"
			log_limited "telegram_${method}_wget_fail" 30 "telegram wget failed method=$method timeout=${timeout}s total=$(( $(now) - started ))s"
			return 1
		}
	fi
	log_debug "telegram request ok method=$method transport=wget duration=$(( $(now) - started ))s bytes=${#resp}"
	[ "$note_mode" = "note" ] && telegram_note_success
	printf '%s' "$resp"
}

telegram_request_retry() {
	method="$1"
	post_data="$2"
	attempts="$(telegram_send_retries)"
	attempt=1
	while [ "$attempt" -le "$attempts" ]; do
		resp="$(telegram_request "$method" "$post_data")" && {
			printf '%s' "$resp"
			return 0
		}
		[ "$attempt" -ge "$attempts" ] && break
		log_limited "telegram_${method}_retry" 30 "telegram request retry method=$method next_attempt=$((attempt + 1)) max_attempts=$attempts"
		sleep 2
		attempt=$((attempt + 1))
	done
	return 1
}

urlencode() {
	awk '
	BEGIN {
		for (i = 0; i < 256; i++) ord[sprintf("%c", i)] = i
	}
	{
		if (NR > 1) printf "%%0A"
		for (i = 1; i <= length($0); i++) {
			c = substr($0, i, 1)
			if (c ~ /[A-Za-z0-9_.~-]/) {
				printf "%s", c
			} else if (c == " ") {
				printf "+"
			} else {
				printf "%%%02X", ord[c]
			}
		}
	}
	'
}

telegram_send() {
	text="$1"
	chat_id="${2:-$(cfg chat_id)}"
	mode="${3:-plain}"
	telegram_ready || return 0
	[ -n "$chat_id" ] || return 0
	token="$(cfg bot_token)"
	encoded="$(printf '%s' "$text" | urlencode)"
	post_data="chat_id=$chat_id&text=$encoded"
	[ "$mode" = "html" ] && post_data="$post_data&parse_mode=HTML&disable_web_page_preview=true"
	resp="$(telegram_request_retry sendMessage "$post_data")" || {
		log "telegram send failed"
		return 1
	}
	case "$resp" in
		*'"ok":true'*) return 0 ;;
		*)
			telegram_note_failure send_rejected
			log "telegram send rejected: $(printf '%s' "$resp" | cut -c1-220)"
			;;
	esac
	return 1
}

telegram_send_markup() {
	text="$1"
	markup="$2"
	chat_id="${3:-$(cfg chat_id)}"
	mode="${4:-plain}"
	telegram_ready || return 0
	[ -n "$chat_id" ] || return 0
	token="$(cfg bot_token)"
	encoded_text="$(printf '%s' "$text" | urlencode)"
	encoded_markup="$(printf '%s' "$markup" | urlencode)"
	post_data="chat_id=$chat_id&text=$encoded_text&reply_markup=$encoded_markup"
	[ "$mode" = "html" ] && post_data="$post_data&parse_mode=HTML&disable_web_page_preview=true"
	resp="$(telegram_request_retry sendMessage "$post_data")" || {
		log "telegram send markup failed"
		return 1
	}
	case "$resp" in
		*'"ok":true'*) return 0 ;;
		*)
			telegram_note_failure send_markup_rejected
			log "telegram send markup rejected: $(printf '%s' "$resp" | cut -c1-220)"
			;;
	esac
	return 1
}

telegram_edit_markup() {
	text="$1"
	markup="$2"
	chat_id="$3"
	message_id="$4"
	mode="${5:-plain}"
	telegram_ready || return 0
	[ -n "$chat_id" ] && [ -n "$message_id" ] || return 1
	token="$(cfg bot_token)"
	encoded_text="$(printf '%s' "$text" | urlencode)"
	encoded_markup="$(printf '%s' "$markup" | urlencode)"
	post_data="chat_id=$chat_id&message_id=$message_id&text=$encoded_text&reply_markup=$encoded_markup"
	[ "$mode" = "html" ] && post_data="$post_data&parse_mode=HTML&disable_web_page_preview=true"
	resp="$(telegram_request_retry editMessageText "$post_data")" || {
		log "telegram edit markup failed"
		return 1
	}
	case "$resp" in
		*'"ok":true'*) return 0 ;;
		*)
			telegram_note_failure edit_markup_rejected
			log "telegram edit markup rejected: $(printf '%s' "$resp" | cut -c1-220)"
			;;
	esac
	return 1
}

html_escape() {
	sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g'
}

miner_link() {
	link_name="$(printf '%s' "$1" | html_escape)"
	link_ip="$2"
	printf '<a href="http://%s">%s</a>' "$link_ip" "$link_name"
}

telegram_answer_callback() {
	callback_id="$1"
	text="$2"
	telegram_ready || return 0
	[ -n "$callback_id" ] || return 0
	encoded_text="$(printf '%s' "$text" | urlencode)"
	telegram_request answerCallbackQuery "callback_query_id=$callback_id&text=$encoded_text" >/dev/null 2>&1 || true
}

status_badge() {
	case "$1" in
		Overheat|overheat) echo "[HOT]" ;;
		Idle|idle) echo "[IDLE]" ;;
		"Fan fault"|fan_fault) echo "[FAN]" ;;
		"Bad shares"|bad_shares) echo "[SHARES]" ;;
		"API down"|api_down) echo "[DOWN]" ;;
		RECOVERED|ok|OK) echo "[OK]" ;;
		AUTO-REBOOT) echo "[REBOOT]" ;;
		*) echo "[INFO]" ;;
	esac
}

status_key() {
	case "$1" in
		Overheat|overheat) echo "overheat" ;;
		Idle|idle) echo "idle" ;;
		"Fan fault"|fan_fault) echo "fan_fault" ;;
		"Hash drop"|hash_drop) echo "hash_drop" ;;
		"Bad shares"|bad_shares) echo "bad_shares" ;;
		"API down"|api_down) echo "api_down" ;;
		RECOVERED|ok|OK) echo "ok" ;;
		AUTO-REBOOT) echo "auto_reboot" ;;
		*) printf '%s' "$1" | tr 'A-Z ' 'a-z_' ;;
	esac
}

detail_value() {
	detail_text="$1"
	key="$2"
	printf '%s' "$detail_text" | tr ' ' '\n' | sed -n "s/^$key=//p" | sed -n '1p'
}

format_percent() {
	value="$1"
	[ -n "$value" ] || return
	case "$value" in
		*%) printf '%s' "$value" ;;
		*) printf '%s%%' "$value" ;;
	esac
}

format_rpm() {
	value="$(num_or_zero "$1")"
	if gt_num "$value" 0; then
		printf '%srpm' "$value"
	else
		printf 'нет данных'
	fi
}

format_ping_alert() {
	case "$1" in
		fail|'') printf 'нет ответа' ;;
		ok*) printf '%s' "$1" | sed 's/^ok //; s/ms$/ мс/' ;;
		*) printf '%s' "$1" ;;
	esac
}

pool_test_targets() {
	coin="$(printf '%s' "$1" | tr 'A-Z' 'a-z')"
	case "$coin" in
		btc)
			cat <<'EOF'
BTC btc.viabtc.io 3333 Глобальный
BTC btc.viabtc.io 443 Глобальный-резерв
BTC btc.viabtc.cc 3333 Глобальный
BTC btc.viabtc.cc 443 Глобальный-резерв
BTC btc.viabtc.top 3333 Глобальный
BTC btc.viabtc.top 443 Глобальный-резерв
BTC btc.powhashing.com 3333 Европа
BTC btc.powhashing.com 443 Европа-резерв
BTC btc-ssl.viabtc.io 551 SSL
BTC btc-ssl.powhashing.com 3333 Европа-SSL
EOF
			;;
		zec)
			cat <<'EOF'
ZEC mining.viabtc.io 3002 Глобальный
ZEC mining.viabtc.io 302 Глобальный-резерв
ZEC mining.viabtc.top 3002 Глобальный
ZEC mining.viabtc.top 302 Глобальный-резерв
ZEC zec.powhashing.com 3002 Европа
ZEC hash-ssl.viabtc.top 3002 SSL
EOF
			;;
		all)
			pool_test_targets btc
			pool_test_targets zec
			;;
	esac
}

pool_probe_tcp() {
	host="$1"
	port="$2"
	timeout="${3:-5}"
	if command -v curl >/dev/null 2>&1; then
		t="$(curl -sS -o /dev/null --connect-timeout "$timeout" --max-time "$timeout" \
			-w '%{time_connect}' "http://$host:$port" 2>/dev/null || true)"
		if printf '%s' "$t" | awk '{ exit !(($1 + 0) > 0) }'; then
			printf '%s\n' "$t"
			return 0
		fi
	fi
	start="$(now)"
	( : | nc "$host" "$port" >/dev/null 2>&1 ) &
	pid="$!"
	waited=0
	while kill -0 "$pid" 2>/dev/null; do
		[ "$waited" -ge "$timeout" ] && {
			kill "$pid" 2>/dev/null || true
			wait "$pid" 2>/dev/null || true
			printf 'fail\n'
			return 1
		}
		sleep 1
		waited=$((waited + 1))
	done
	wait "$pid" 2>/dev/null || {
		printf 'fail\n'
		return 1
	}
	ping_ms="$(ping -c 1 -W "$timeout" "$host" 2>/dev/null | awk -F'time=' '/time=/{ split($2,a," "); print a[1]; ok=1; exit } END { if (!ok) print "" }')"
	if [ -n "$ping_ms" ]; then
		awk -v ms="$ping_ms" 'BEGIN { printf "%.3f\n", ms / 1000 }'
		return 0
	fi
	elapsed=$(( $(now) - start ))
	[ "$elapsed" -le 0 ] && elapsed=1
	printf '%s.000\n' "$elapsed"
}

pool_test_one() {
	coin="$1"
	host="$2"
	port="$3"
	label="$4"
	duration="$5"
	interval="$6"
	timeout="$7"
	end=$(( $(now) + duration ))
	total=0
	ok=0
	sum="0"
	best=""
	while [ "$(now)" -lt "$end" ]; do
		total=$((total + 1))
		result="$(pool_probe_tcp "$host" "$port" "$timeout")"
		case "$result" in
			fail|'') ;;
			*)
				ok=$((ok + 1))
				sum="$(awk -v a="$sum" -v b="$result" 'BEGIN { printf "%.3f", a + b }')"
				if [ -z "$best" ] || awk -v a="$result" -v b="$best" 'BEGIN { exit !(a < b) }'; then
					best="$result"
				fi
				;;
		esac
		[ "$(now)" -lt "$end" ] && sleep "$interval"
	done
	if [ "$ok" -gt 0 ]; then
		avg="$(awk -v s="$sum" -v n="$ok" 'BEGIN { printf "%.3f", s / n }')"
		score="$(awk -v ok="$ok" -v total="$total" -v avg="$avg" 'BEGIN { printf "%.3f", (ok / total * 1000) - avg }')"
		printf '%s %s:%s %s · успешно %s/%s · среднее %sс · лучше %sс · оценка=%s\n' "$coin" "$host" "$port" "$label" "$ok" "$total" "$avg" "$best" "$score"
	else
		printf '%s %s:%s %s · успешно 0/%s · среднее - · лучше - · оценка=0\n' "$coin" "$host" "$port" "$label" "$total"
	fi
}

pool_test() {
	coin="$(printf '%s' "${1:-all}" | tr 'A-Z' 'a-z')"
	duration="${2:-$(cfg pool_test_duration 300)}"
	interval="${3:-$(cfg pool_test_interval 10)}"
	timeout="${4:-$(cfg pool_test_timeout 5)}"
	case "$coin" in btc|zec|all) ;; *) echo "Формат: pool-test btc|zec|all [общих_секунд] [интервал_сек]"; return 1 ;; esac
	duration="$(num_or_zero "$duration")"
	interval="$(num_or_zero "$interval")"
	timeout="$(num_or_zero "$timeout")"
	[ "$duration" -ge 5 ] 2>/dev/null || duration=5
	[ "$interval" -ge 1 ] 2>/dev/null || interval=1
	[ "$timeout" -ge 1 ] 2>/dev/null || timeout=5
	target_count="$(pool_test_targets "$coin" | awk 'NF { n++ } END { print n + 0 }')"
	[ "$target_count" -gt 0 ] 2>/dev/null || {
		echo "Нет адресов пулов для теста: $coin"
		return 1
	}
	per_target=$((duration / target_count))
	[ "$per_target" -ge 5 ] 2>/dev/null || per_target=5
	tmp="$RUNDIR/pool-test-$$.txt"
	{
		printf 'Тест пулов %s: общий лимит %sс, адресов %s, примерно %sс на адрес, интервал %sс, timeout %sс\n' "$coin" "$duration" "$target_count" "$per_target" "$interval" "$timeout"
		printf 'Проверяется только TCP-доступ. Настройки ASIC не меняются.\n'
	} >"$tmp"
	best_score=""
	best_line=""
	pool_test_targets "$coin" | while read -r tcoin host port label; do
		[ -n "$host" ] || continue
		line="$(pool_test_one "$tcoin" "$host" "$port" "$label" "$per_target" "$interval" "$timeout")"
		printf '%s\n' "$line" >>"$tmp"
	done
	sorted="$tmp.sorted"
	header="$(sed -n '1,2p' "$tmp")"
	{
		printf '%s\n' "$header"
		sed '1,2d' "$tmp" | awk '
			{
				score = 0
				if (match($0, /оценка=[0-9.]+/)) score = substr($0, RSTART + 7, RLENGTH - 7) + 0
				printf "%012.3f %s\n", 1000000 - score, $0
			}' | sort | sed 's/^[0-9.][0-9.]* //'
	} >"$sorted"
	mv "$sorted" "$tmp"
	while IFS= read -r line; do
		score="$(printf '%s' "$line" | sed -n 's/.* оценка=\([0-9.][0-9.]*\).*/\1/p')"
		[ -n "$score" ] || continue
		if [ -z "$best_score" ] || awk -v a="$score" -v b="$best_score" 'BEGIN { exit !(a > b) }'; then
			best_score="$score"
			best_line="$line"
		fi
	done <"$tmp"
	[ -n "$best_line" ] && printf 'Лучший: %s\n' "$best_line" >>"$tmp"
	cat "$tmp"
	rm -f "$tmp"
}

alert_recommendation() {
	case "$(status_key "$1")" in
		overheat)
			echo "💡 Проверь продув, пыль, температуру помещения и режим разгона."
			;;
		fan_fault)
			echo "💡 Проверь вентилятор, разъём, питание и обороты по платам."
			;;
		idle)
			echo "💡 Проверь пул, сеть, питание и не просела ли одна из плат."
			;;
		bad_shares)
			echo "💡 Проверь пул, сеть, частоты, питание и стабильность плат."
			;;
		api_down)
			echo "💡 Проверь питание ASIC, IP, сеть и доступность порта 4028."
			;;
		ok)
			echo "💡 ASIC снова в норме. Продолжаю наблюдение."
			;;
	esac
}

format_alert_detail() {
	status_text="$1"
	detail_text="$2"
	alert_out=""
	event_key="$(status_key "$status_text")"
	temp="$(detail_value "$detail_text" temp)"
	limit="$(detail_value "$detail_text" limit)"
	hash="$(detail_value "$detail_text" hash)"
	min_hash="$(detail_value "$detail_text" min)"
	accepted="$(detail_value "$detail_text" accepted)"
	rejected="$(detail_value "$detail_text" rejected)"
	bad="$(detail_value "$detail_text" bad)"
	hw="$(detail_value "$detail_text" hw)"
	hw_delta="$(detail_value "$detail_text" hw_delta)"
	fan_min="$(detail_value "$detail_text" fan_min)"
	fans="$(detail_value "$detail_text" fans)"
	ping="$(detail_value "$detail_text" ping)"

	if [ -n "$temp" ]; then
		line="🌡 Температура: $(format_temp "$temp")"
		[ -n "$limit" ] && [ "$event_key" != "fan_fault" ] && line="$line, лимит $(format_temp "$limit")"
		alert_out="${alert_out}
$line"
	fi
	if [ -n "$fan_min" ]; then
		line="🌀 Мин. вентилятор: $(format_rpm "$fan_min")"
		[ -n "$limit" ] && [ "$event_key" = "fan_fault" ] && line="$line, лимит $(format_rpm "$limit")"
		alert_out="${alert_out}
$line"
	fi
	[ -n "$fans" ] && alert_out="${alert_out}
🌀 Все вентиляторы: $fans"
	if [ -n "$hash" ]; then
		line="⚡️ Скорость добычи: $(format_hashrate "$hash")"
		[ -n "$min_hash" ] && line="$line, минимум $(format_hashrate "$min_hash")"
		alert_out="${alert_out}
$line"
	fi
	[ -n "$accepted" ] && alert_out="${alert_out}
✅ Разгадал блоков: $accepted"
	[ -n "$rejected" ] && alert_out="${alert_out}
❌ Не отгадал: $rejected"
	[ -n "$bad" ] && alert_out="${alert_out}
📉 Битые шары: $(format_percent "$bad")"
	[ -n "$hw" ] && alert_out="${alert_out}
🧯 HW ошибок всего: $hw"
	[ -n "$hw_delta" ] && alert_out="${alert_out}
🧯 HW ошибок за цикл: $hw_delta"
	[ -n "$ping" ] && alert_out="${alert_out}
🌐 Ping: $(format_ping_alert "$ping")"
	rec="$(alert_recommendation "$status_text")"
	[ -n "$rec" ] && alert_out="${alert_out}
$rec"

	if [ -n "$alert_out" ]; then
		printf '%s\n' "$alert_out" | sed '1{/^$/d;}'
	else
		printf '%s\n' "$detail_text"
	fi
}

notify_event() {
	name="$1"
	ip="$2"
	status_text="$3"
	detail="$4"
	current="$(now)"
	event_key="$(status_key "$status_text")"
	cooldown="$(cfg alert_cooldown 3600)"
	linked_name="$(miner_link "$name" "$ip")"
	if [ "$event_key" = "api_down" ]; then
		if [ "${last_status:-unknown}" != "api_down" ]; then
			msg="🚨 ${linked_name} выключен

Нет ответа от ASIC/API.
Проверка каждые $(cfg interval 30) сек. Следующее уведомление будет когда устройство включится."
			telegram_send "$msg" "" html
			log "$name $ip offline $detail"
			last_alert="$current"
		fi
		return 0
	fi
	if [ "$event_key" = "ok" ] && [ "${last_status:-unknown}" = "api_down" ]; then
		msg="✅ ${linked_name} включился

ASIC снова отвечает.
🌡 Температура: $(format_temp "${temp:-$(detail_value "$detail" temp)}")
⚡️ Скорость добычи: $(format_hashrate "${hashrate:-$(detail_value "$detail" hash)}")"
		telegram_send "$msg" "" html
		log "$name $ip online $detail"
		last_alert="$current"
		return 0
	fi
	if [ "$event_key" != "${last_status:-unknown}" ] || [ $((current - ${last_alert:-0})) -ge "$cooldown" ]; then
		icon="$(telegram_status_icon "$event_key")"
		display_status="$(telegram_status_label "$status_text")"
		metric_temp="${temp:-$(detail_value "$detail" temp)}"
		metric_hash="${hashrate:-$(detail_value "$detail" hash)}"
		metric_hash_24h="${hashrate_24h:-$(detail_value "$detail" hash_24h)}"
		metric_bad="${bad_pct:-$(detail_value "$detail" bad)}"
		metric_fan="${fan_min:-$(detail_value "$detail" fan_min)}"
		[ -n "$metric_bad" ] || metric_bad="0"
		msg="${icon} ${linked_name} · ${display_status}
$(compact_miner_metrics "$metric_hash" "$metric_hash_24h" "$metric_bad" "$metric_temp" "$metric_fan")"
		telegram_send "$msg" "" html
		log "$name $ip $status_text $detail"
		last_alert="$current"
	fi
}

critical_notify() {
	key="$1"
	active="$2"
	alert_msg="$3"
	recover_msg="$4"
	case "$key" in
		api_down) flag="${crit_api_down:-0}" ;;
		fan_fault) flag="${crit_fan_fault:-0}" ;;
		hash_drop) flag="${crit_hash_drop:-0}" ;;
		bad_hour) flag="${crit_bad_hour:-0}" ;;
		*) return 0 ;;
	esac

	if [ "$active" = "1" ]; then
		[ "$flag" = "1" ] && return 0
		telegram_send "$alert_msg" "" html
		log "$name $ip critical $key"
		case "$key" in
			api_down) crit_api_down=1 ;;
			fan_fault) crit_fan_fault=1 ;;
			hash_drop) crit_hash_drop=1 ;;
			bad_hour) crit_bad_hour=1 ;;
		esac
	else
		[ "$flag" = "1" ] || return 0
		telegram_send "$recover_msg" "" html
		log "$name $ip recovered $key"
		case "$key" in
			api_down) crit_api_down=0 ;;
			fan_fault) crit_fan_fault=0 ;;
			hash_drop) crit_hash_drop=0 ;;
			bad_hour) crit_bad_hour=0 ;;
		esac
	fi
	last_alert="$(now)"
}

reboot_miner_section() {
	sec="$1"
	name="$(section_cfg "$sec" name "$sec")"
	ip="$(section_cfg "$sec" ip)"
	port="$(section_cfg "$sec" api_port 4028)"
	model="$(section_cfg "$sec" model generic)"
	method="$(section_cfg "$sec" reboot_method "")"
	user="$(section_cfg "$sec" user root)"
	password="$(section_cfg "$sec" password root)"

	[ -z "$ip" ] && {
		printf 'не указан IP для %s\n' "$sec"
		return 1
	}
	[ -z "$method" ] && {
		case "$model" in
			antminer) method="antminer_web" ;;
			*) method="api" ;;
		esac
	}

	case "$method" in
		none)
			printf 'перезагрузка отключена для %s (%s)\n' "$name" "$ip"
			return 1
			;;
		antminer_web|web)
			wget -qO- --user="$user" --password="$password" "http://$ip/cgi-bin/reboot.cgi" >/dev/null 2>&1 ||
				wget -qO- "http://$user:$password@$ip/cgi-bin/reboot.cgi" >/dev/null 2>&1
			rc=$?
			;;
		api)
			cgminer_cmd "$ip" "$port" "reboot" >/dev/null 2>&1 ||
				cgminer_cmd "$ip" "$port" "restart" >/dev/null 2>&1
			rc=$?
			;;
		restart)
			cgminer_cmd "$ip" "$port" "restart" >/dev/null 2>&1
			rc=$?
			;;
		*)
			printf 'неизвестный метод перезагрузки: %s\n' "$method"
			return 1
			;;
	esac

	if [ "$rc" -eq 0 ]; then
		printf 'команда отправлена на %s (%s), метод: %s\n' "$name" "$ip" "$method"
		log "reboot command sent to $name $ip by $method"
	else
		printf 'команда не прошла для %s (%s), метод: %s\n' "$name" "$ip" "$method"
	fi
	return "$rc"
}

find_miner_section() {
	target="$1"
	for sec in $(miner_sections); do
		name="$(section_cfg "$sec" name "$sec")"
		ip="$(section_cfg "$sec" ip)"
		[ "$target" = "$name" ] || [ "$target" = "$ip" ] || [ "$target" = "$sec" ] || [ "$target" = "${sec#@miner}" ] && {
			printf '%s' "$sec"
			return 0
		}
	done
	return 1
}

reboot_miner() {
	target="$1"
	sec="$(find_miner_section "$target")" || {
		printf 'ASIC не найден: %s\n' "$target"
		return 1
	}
	reboot_miner_section "$sec"
}

maybe_auto_reboot() {
	reason="$1"
	sec="$2"
	current="$(now)"
	cooldown="$(cfg reboot_cooldown 1800)"
	case "$reason" in
		overheat) [ "$(cfg auto_reboot_on_overheat 0)" = "1" ] || return 0 ;;
		idle) [ "$(cfg auto_reboot_on_idle 0)" = "1" ] || return 0 ;;
		bad_shares) [ "$(cfg auto_reboot_on_bad_shares 0)" = "1" ] || return 0 ;;
		*) return 0 ;;
	esac
	[ $((current - ${last_reboot:-0})) -lt "$cooldown" ] && return 0
	if reboot_miner_section "$sec" >/tmp/asic-watchdog/reboot.out 2>&1; then
		last_reboot="$current"
		notify_event "$name" "$ip" "AUTO-REBOOT" "$reason: $(cat /tmp/asic-watchdog/reboot.out)"
	fi
}

check_miner() {
	sec="$1"
	enabled="$(section_cfg "$sec" enabled 1)"
	[ "$enabled" = "1" ] || return 0

	name="$(section_cfg "$sec" name "$sec")"
	ip="$(section_cfg "$sec" ip)"
	model="$(section_cfg "$sec" model generic)"
	port="$(section_cfg "$sec" api_port 4028)"
	max_temp="$(section_cfg "$sec" max_temp "$(cfg max_temp 85)")"
	min_hashrate="$(section_cfg "$sec" min_hashrate "$(cfg min_hashrate 1)")"
	fail_cycles="$(cfg fail_cycles 2)"
	state_file="$RUNDIR/miner-$(safe_id "$name-$ip").state"
	share_sample_file="$RUNDIR/shares-$(safe_id "$name-$ip").tsv"
	history_sample_file="$RUNDIR/history-$(safe_id "$name-$ip").tsv"
	load_miner_state "$state_file"
	current="$(now)"

	status="ok"
	reason="OK"
	detail=""
	temp=0
	hashrate=0
	accepted=0
	rejected=0
	hw_errors=0
	bad_pct=0
	api_ok=0
	fan_rpm=""
	fan_min=0
	fan_count=0
	board_temps=""
	chip_temps=""
	board_hashrates=""
	board_chips=""
	board_status=""
	board_hw=""
	uptime=""
	pools=""
	autotune=""
	ping=""
	hw_delta=0
	bad_hour_pct=0
	bad_hour_elapsed=0
	bad_hour_accepted=0
	bad_hour_rejected=0
	hashrate_24h=0
	accepted_today=0
	accepted_yday_same=0
	accepted_vs_yday_pct=""
	temp_avg_24h=0
	temp_max_24h=0
	fan_min_24h=0
	bad_avg_24h=0
	bad_max_24h=0
	hashrate_spark_24h=""
	temp_spark_24h=""
	bad_spark_24h=""
	hash_drop_limit=0
	hash_recovery_limit=0

	if [ -z "$ip" ]; then
		status="config_error"
		reason="No IP"
	else
		summary="$(cgminer_cmd "$ip" "$port" "summary")"
		stats="$(cgminer_cmd "$ip" "$port" "stats")"
		devs="$(cgminer_cmd "$ip" "$port" "devs")"
		pools_raw="$(cgminer_cmd "$ip" "$port" "pools")"
		raw="$summary
$stats
$devs
$pools_raw"
		if [ -n "$summary$stats" ]; then
			api_ok=1
			temp="$(max_temp_from_text "$raw")"
			hashrate="$(hashrate_from_text "$raw")"
			accepted="$(accepted_from_text "$raw")"
			rejected="$(rejected_from_text "$raw")"
			hw_errors="$(hw_errors_from_text "$raw")"
			fan_rpm="$(fan_rpm_from_text "$raw")"
			fan_min="$(min_from_list "$fan_rpm")"
			fan_count="$(count_from_list "$fan_rpm")"
			board_temps="$(board_temps_from_text "$raw")"
			chip_temps="$(chip_temps_from_text "$raw")"
			board_hashrates="$(board_hashrates_from_text "$raw")"
			board_chips="$(board_chips_from_text "$raw")"
			board_status="$(board_status_from_text "$raw")"
			board_hw="$(board_hw_from_text "$raw")"
			uptime="$(uptime_from_text "$raw")"
			pools="$(pools_from_text "$raw")"
			autotune="$(autotune_from_text "$raw")"
			ping="$(ping_status "$ip")"
			bad_pct="$(bad_share_percent "$accepted" "$rejected")"
			hw_delta="$(awk -v a="$(num_or_zero "$hw_errors")" -v b="$(num_or_zero "${last_hw:-0}")" 'BEGIN { d=a-b; if (d < 0) d=0; print d }')"
			share_stats="$(share_hour_stats "$share_sample_file" "$current" "$accepted" "$rejected")"
			bad_hour_pct="$(printf '%s' "$share_stats" | awk '{ print $1 }')"
			bad_hour_elapsed="$(printf '%s' "$share_stats" | awk '{ print $2 }')"
			bad_hour_accepted="$(printf '%s' "$share_stats" | awk '{ print $3 }')"
			bad_hour_rejected="$(printf '%s' "$share_stats" | awk '{ print $4 }')"
			history_stats="$(miner_history_stats "$history_sample_file" "$current" "$accepted" "$rejected" "$hashrate" "$temp" "$fan_min" "$bad_pct")"
			hashrate_24h="$(printf '%s' "$history_stats" | awk -F'|' '{ print $1 }')"
			accepted_today="$(printf '%s' "$history_stats" | awk -F'|' '{ print $2 }')"
			accepted_yday_same="$(printf '%s' "$history_stats" | awk -F'|' '{ print $3 }')"
			accepted_vs_yday_pct="$(printf '%s' "$history_stats" | awk -F'|' '{ print $4 }')"
			temp_avg_24h="$(printf '%s' "$history_stats" | awk -F'|' '{ print $5 }')"
			temp_max_24h="$(printf '%s' "$history_stats" | awk -F'|' '{ print $6 }')"
			fan_min_24h="$(printf '%s' "$history_stats" | awk -F'|' '{ print $7 }')"
			bad_avg_24h="$(printf '%s' "$history_stats" | awk -F'|' '{ print $8 }')"
			bad_max_24h="$(printf '%s' "$history_stats" | awk -F'|' '{ print $9 }')"
			hashrate_spark_24h="$(printf '%s' "$history_stats" | awk -F'|' '{ print $10 }')"
			temp_spark_24h="$(printf '%s' "$history_stats" | awk -F'|' '{ print $11 }')"
			bad_spark_24h="$(printf '%s' "$history_stats" | awk -F'|' '{ print $12 }')"
			bad_hour_limit="$(cfg bad_share_hour_percent 1)"
			hash_drop_percent="$(cfg hashrate_drop_percent 30)"
			hash_recovery_percent="$(cfg hashrate_recovery_percent 85)"
			if ! gt_num "${baseline_hashrate:-0}" 0 && gt_num "$hashrate" 0; then
				baseline_hashrate="$hashrate"
			fi
			if gt_num "$hashrate" "${baseline_hashrate:-0}"; then
				baseline_hashrate="$hashrate"
			fi
			hash_drop_limit="$(awk -v b="$(num_or_zero "${baseline_hashrate:-0}")" -v p="$(num_or_zero "$hash_drop_percent")" 'BEGIN { printf "%.2f", b*(100-p)/100 }')"
			hash_recovery_limit="$(awk -v b="$(num_or_zero "${baseline_hashrate:-0}")" -v p="$(num_or_zero "$hash_recovery_percent")" 'BEGIN { printf "%.2f", b*p/100 }')"

			if ge_num "$temp" "$max_temp" && gt_num "$temp" 0; then hot_count=$((hot_count + 1)); else hot_count=0; fi
			if gt_num "$min_hashrate" 0 && ge_num "$min_hashrate" "$hashrate"; then idle_count=$((idle_count + 1)); else idle_count=0; fi
			if [ "$bad_hour_elapsed" -ge 3600 ] && pct_gt "$bad_hour_pct" "$bad_hour_limit"; then bad_count=$((bad_count + 1)); else bad_count=0; fi
			if gt_num "$hash_drop_limit" 0 && gt_num "$hash_drop_limit" "$hashrate"; then
				hash_drop_count=$((hash_drop_count + 1))
			elif [ "${crit_hash_drop:-0}" = "1" ] && gt_num "$hash_recovery_limit" "$hashrate"; then
				hash_drop_count=$((hash_drop_count + 1))
			else
				hash_drop_count=0
			fi

			fan_fault_active=0
			hash_drop_active=0
			bad_hour_active=0
			if gt_num "$fan_count" 0 && gt_num "$(cfg min_fan_rpm 1000)" "$fan_min"; then fan_fault_active=1; fi
			if [ "$hash_drop_count" -ge "$fail_cycles" ]; then hash_drop_active=1; fi
			if [ "$bad_count" -ge "$fail_cycles" ]; then bad_hour_active=1; fi
			if [ "${crit_bad_hour:-0}" = "1" ] && [ "$bad_hour_elapsed" -lt 3600 ]; then bad_hour_active=1; fi

			linked_name="$(miner_link "$name" "$ip")"
			critical_notify api_down 0 "🚨 ${linked_name} выключен" "✅ ${linked_name} включился

ASIC снова отвечает.
🌡 Температура: $(format_temp "$temp")
⚡️ Скорость добычи: $(format_hashrate "$hashrate")"
			critical_notify fan_fault "$fan_fault_active" "🚨 ${linked_name}   🌀 Проблема с вентилятором

🌀 Мин. вентилятор: $(format_fan "$fan_min"), лимит $(format_fan "$(cfg min_fan_rpm 1000)")
🌡 Температура: $(format_temp "$temp")
⚡️ Скорость добычи: $(format_hashrate "$hashrate")
💡 Проверь вентилятор, разъём, питание и обороты по платам." "✅ ${linked_name} вентилятор восстановился

🌀 Мин. вентилятор: $(format_fan "$fan_min")
🌡 Температура: $(format_temp "$temp")"
			critical_notify hash_drop "$hash_drop_active" "🚨 ${linked_name}   📉 Сильное снижение скорости добычи

⚡️ Сейчас: $(format_hashrate "$hashrate")
📊 Норма/baseline: $(format_hashrate "${baseline_hashrate:-0}")
📉 Порог тревоги: $(format_hashrate "$hash_drop_limit") (-${hash_drop_percent}%)
💡 Проверь платы, питание, пул, сеть, температуру и режим разгона." "✅ ${linked_name} скорость добычи восстановилась

⚡️ Сейчас: $(format_hashrate "$hashrate")
📊 Baseline: $(format_hashrate "${baseline_hashrate:-0}")"
			critical_notify bad_hour "$bad_hour_active" "🚨 ${linked_name}   ❌ Битые шары выше нормы

📉 За последний час: $(format_percent "$bad_hour_pct"), лимит $(format_percent "$bad_hour_limit")
✅ Разгадал за час: ${bad_hour_accepted:-0} ❌ Не отгадал за час: ${bad_hour_rejected:-0}
💡 Проверь пул, сеть, частоты, питание и стабильность плат." "✅ ${linked_name} битые шары восстановились

📉 За последний час: $(format_percent "$bad_hour_pct"), лимит $(format_percent "$bad_hour_limit")"

			if [ "$fan_fault_active" = "1" ]; then
				status="fan_fault"
				reason="Fan fault"
				detail="fan_min=${fan_min}rpm limit=$(cfg min_fan_rpm 1000)rpm fans=${fan_rpm} temp=${temp}C hash=${hashrate}"
			elif [ "$hash_drop_active" = "1" ]; then
				status="hash_drop"
				reason="Hash drop"
				detail="hash=${hashrate} baseline=${baseline_hashrate:-0} limit=${hash_drop_limit} temp=${temp}C accepted=${accepted} rejected=${rejected} bad=${bad_pct}%"
			elif [ "$hot_count" -ge "$fail_cycles" ]; then
				status="overheat"
				reason="Overheat"
				detail="temp=${temp}C limit=${max_temp}C hash=${hashrate} accepted=${accepted} rejected=${rejected} bad=${bad_pct}% hw_delta=${hw_delta}"
				notify_event "$name" "$ip" "$reason" "$detail"
				maybe_auto_reboot overheat "$sec"
			elif [ "$idle_count" -ge "$fail_cycles" ]; then
				status="idle"
				reason="Idle"
				detail="hash=${hashrate} min=${min_hashrate} temp=${temp}C accepted=${accepted} rejected=${rejected} bad=${bad_pct}%"
				notify_event "$name" "$ip" "$reason" "$detail"
				maybe_auto_reboot idle "$sec"
			elif [ "$bad_hour_active" = "1" ]; then
				status="bad_shares"
				reason="Bad shares"
				detail="accepted=${accepted} rejected=${rejected} bad=${bad_pct}% hour_bad=${bad_hour_pct}% hour_accepted=${bad_hour_accepted} hour_rejected=${bad_hour_rejected} hw=${hw_errors} hw_delta=${hw_delta} hash=${hashrate}"
				maybe_auto_reboot bad_shares "$sec"
			else
				status="ok"
				reason="OK"
				detail="hash=${hashrate} temp=${temp}C accepted=${accepted} rejected=${rejected} bad=${bad_pct}% hw=${hw_errors}"
				if [ "${last_status:-unknown}" != "ok" ] && [ "${last_status:-unknown}" != "unknown" ] &&
					[ "${last_status:-unknown}" != "api_down" ] && [ "${last_status:-unknown}" != "fan_fault" ] &&
					[ "${last_status:-unknown}" != "hash_drop" ] && [ "${last_status:-unknown}" != "bad_shares" ]; then
					notify_event "$name" "$ip" "RECOVERED" "$detail"
				fi
			fi
		else
			status="api_down"
			reason="API down"
			ping="$(ping_status "$ip")"
			detail="no answer from $ip:$port ping=$ping"
			linked_name="$(miner_link "$name" "$ip")"
			critical_notify api_down 1 "🚨 ${linked_name} выключен

Нет ответа от ASIC/API.
Проверка каждые $(cfg interval 30) сек. Следующее уведомление будет когда устройство включится." "✅ ${linked_name} включился"
		fi
	fi

	save_miner_state "$state_file"

	[ "$JSON_FIRST" = "0" ] && printf ',' >>"$STATUS_TMP"
	JSON_FIRST=0
	{
		printf '{'
		jfield section "$sec"; printf ','
		jfield name "$name"; printf ','
		jfield ip "$ip"; printf ','
		jfield model "$model"; printf ','
		jfield status "$status"; printf ','
		jfield reason "$reason"; printf ','
		jfield detail "$detail"; printf ','
		jfield api_ok "$api_ok"; printf ','
		jfield temp "$temp"; printf ','
		jfield hashrate "$hashrate"; printf ','
		jfield hashrate_24h "$hashrate_24h"; printf ','
		jfield temp_avg_24h "$temp_avg_24h"; printf ','
		jfield temp_max_24h "$temp_max_24h"; printf ','
		jfield fan_min_24h "$fan_min_24h"; printf ','
		jfield bad_avg_24h "$bad_avg_24h"; printf ','
		jfield bad_max_24h "$bad_max_24h"; printf ','
		jfield hashrate_spark_24h "$hashrate_spark_24h"; printf ','
		jfield temp_spark_24h "$temp_spark_24h"; printf ','
		jfield bad_spark_24h "$bad_spark_24h"; printf ','
		jfield accepted "$accepted"; printf ','
		jfield accepted_today "$accepted_today"; printf ','
		jfield accepted_yday_same "$accepted_yday_same"; printf ','
		jfield accepted_vs_yday_pct "$accepted_vs_yday_pct"; printf ','
		jfield rejected "$rejected"; printf ','
		jfield bad_pct "$bad_pct"; printf ','
		jfield hw_errors "$hw_errors"; printf ','
		jfield fan_rpm "$fan_rpm"; printf ','
		jfield fan_min "$fan_min"; printf ','
		jfield fan_count "$fan_count"; printf ','
		jfield board_temps "$board_temps"; printf ','
		jfield chip_temps "$chip_temps"; printf ','
		jfield board_hashrates "$board_hashrates"; printf ','
		jfield board_chips "$board_chips"; printf ','
		jfield board_status "$board_status"; printf ','
		jfield board_hw "$board_hw"; printf ','
		jfield uptime "$uptime"; printf ','
		jfield pools "$pools"; printf ','
		jfield autotune "$autotune"; printf ','
		jfield ping "$ping"; printf ','
		jfield idle_count "$idle_count"; printf ','
		jfield hot_count "$hot_count"; printf ','
		jfield bad_count "$bad_count"
		printf '}'
	} >>"$STATUS_TMP"
}

check_camera() {
	sec="$1"
	enabled="$(section_cfg "$sec" enabled 1)"
	[ "$enabled" = "1" ] || return 0
	name="$(section_cfg "$sec" name "$sec")"
	ip="$(section_cfg "$sec" ip)"
	state_file="$RUNDIR/camera-$(safe_id "$name-$ip").state"
	load_camera_state "$state_file"
	current="$(now)"
	ping=""
	status="pending"
	reason="Waiting"
	detail=""

	if [ -z "$ip" ]; then
		status="config_error"
		reason="No IP"
		detail="camera has no ip"
	else
		ping="$(ping_status "$ip")"
		case "$ping" in
			ok*)
				status="ok"
				reason="Online"
				detail="ping=$ping"
				if [ "${last_status:-unknown}" = "camera_down" ]; then
					linked_name="$(miner_link "$name" "$ip")"
					msg="✅ ${linked_name} камера включилась

Ping: $(format_ping_alert "$ping")"
					telegram_send "$msg" "" html
					log "camera $name $ip online $detail"
					last_alert="$current"
				fi
				;;
			*)
				status="camera_down"
				reason="Offline"
				detail="ping=fail"
				if [ "${last_status:-unknown}" != "camera_down" ]; then
					linked_name="$(miner_link "$name" "$ip")"
					msg="📷 ${linked_name} камера отключилась

Ping: нет ответа.
Проверка каждые $(cfg interval 30) сек. Следующее уведомление будет когда камера включится."
					telegram_send "$msg" "" html
					log "camera $name $ip offline $detail"
					last_alert="$current"
				fi
				;;
		esac
	fi

	save_camera_state "$state_file"

	[ "$JSON_FIRST" = "0" ] && printf ',' >>"$STATUS_TMP"
	JSON_FIRST=0
	{
		printf '{'
		jfield section "$sec"; printf ','
		jfield name "$name"; printf ','
		jfield ip "$ip"; printf ','
		jfield status "$status"; printf ','
		jfield reason "$reason"; printf ','
		jfield detail "$detail"; printf ','
		jfield ping "$ping"
		printf '}'
	} >>"$STATUS_TMP"
}

write_status_start() {
	current="$(now)"
	{
		printf '{'
		jfield updated "$(date '+%Y-%m-%d %H:%M:%S')"; printf ','
		jfield updated_ts "$current"; printf ','
		jfield interval "$(cfg interval 60)"; printf ','
		jfield service_enabled "$(cfg enabled 1)"; printf ','
		jfield telegram "$(telegram_enabled && echo enabled || echo disabled)"; printf ','
		printf '"miners":['
	} >"$STATUS_TMP"
	JSON_FIRST=1
}

write_status_cameras_start() {
	printf '],"cameras":[' >>"$STATUS_TMP"
	JSON_FIRST=1
}

write_status_end() {
	printf ']}\n' >>"$STATUS_TMP"
	mv "$STATUS_TMP" "$STATUS_FILE"
}

run_once() {
	if ! mkdir "$LOCK_FILE" 2>/dev/null; then
		lock_line="$(cat "$LOCK_FILE/pid" 2>/dev/null || true)"
		old_pid="$(printf '%s' "$lock_line" | awk '{ print $1 }')"
		old_started="$(printf '%s' "$lock_line" | awk '{ print $2 }')"
		monitor_timeout="$(cfg monitor_timeout 180)"
		if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
			current="$(now)"
			lock_age=0
			[ -n "$old_started" ] && lock_age=$((current - old_started))
			if [ -z "$old_started" ] || [ "$lock_age" -ge "$monitor_timeout" ]; then
				log "previous check stale pid=$old_pid age=${lock_age}s timeout=${monitor_timeout}s, stopping it"
				kill "$old_pid" 2>/dev/null || true
				sleep 1
				kill -0 "$old_pid" 2>/dev/null && kill -9 "$old_pid" 2>/dev/null || true
			else
				log "previous check still running age=${lock_age}s"
				return 0
			fi
		fi
		rm -f "$LOCK_FILE/pid" 2>/dev/null || true
		rmdir "$LOCK_FILE" 2>/dev/null || true
		if ! mkdir "$LOCK_FILE" 2>/dev/null; then
			log "previous check still running"
			return 0
		fi
	fi
	echo "$$ $(now)" >"$LOCK_FILE/pid"
	STATUS_TMP="$RUNDIR/status-$$.json.tmp"
	trap 'rm -f "$LOCK_FILE/pid" "$STATUS_TMP" 2>/dev/null; rmdir "$LOCK_FILE" 2>/dev/null' EXIT INT TERM
	check_started="$(now)"
	miner_count=0
	camera_count=0
	log_debug "check start pid=$$"
	write_status_start
	for sec in $(miner_sections); do
		miner_count=$((miner_count + 1))
		check_miner "$sec"
	done
	write_status_cameras_start
	for sec in $(camera_sections); do
		camera_count=$((camera_count + 1))
		check_camera "$sec"
	done
	write_status_end
	log_debug "check complete pid=$$ miners=$miner_count cameras=$camera_count duration=$(( $(now) - check_started ))s"
	rm -f "$LOCK_FILE/pid" 2>/dev/null
	rmdir "$LOCK_FILE" 2>/dev/null
	trap - EXIT INT TERM
}

run_once_async() {
	"$0" run-once >/dev/null 2>&1 &
}

status_updated_ts() {
	head -c 300 "$STATUS_FILE" 2>/dev/null | sed -n 's/.*"updated_ts":"\([0-9][0-9]*\)".*/\1/p'
}

status_age() {
	ts="$(status_updated_ts)"
	current="$(now)"
	if [ -n "$ts" ]; then
		age=$((current - ts))
		[ "$age" -ge 0 ] 2>/dev/null && echo "$age" && return 0
	fi
	echo 999999
}

status_stale_timeout() {
	value="$(cfg status_stale_timeout)"
	if [ -n "$value" ]; then
		echo "$value"
	else
		interval="$(cfg interval 30)"
		echo $((interval * 4))
	fi
}

status_json() {
	if [ -f "$STATUS_FILE" ]; then
		cat "$STATUS_FILE"
	else
		printf '{"updated":"","updated_ts":"0","miners":[],"cameras":[]}\n'
	fi
}

status_text() {
	status_json | sed 's/[{}]//g; s/"miners":\[/\n/g; s/},{/}\n{/g; s/"//g; s/,/ /g' | head -n 80
}

miners_text() {
	for sec in $(miner_sections); do
		name="$(section_cfg "$sec" name "$sec")"
		ip="$(section_cfg "$sec" ip)"
		model="$(section_cfg "$sec" model generic)"
		enabled="$(section_cfg "$sec" enabled 1)"
		printf '%s %s %s enabled=%s\n' "$name" "$ip" "$model" "$enabled"
	done
}

status_updated() {
	head -c 300 "$STATUS_FILE" 2>/dev/null | sed -n 's/.*"updated":"\([^"]*\)".*/\1/p'
}

miner_objects() {
	status_json |
		sed 's/^.*"miners":\[//; s/\],"cameras":.*$//; s/\]}$//' |
		sed '/^$/d' |
		sed 's/},{/}\n/g; s/^{//; s/}$//'
}

camera_objects() {
	status_json |
		sed 's/^.*"cameras":\[//; s/\]}$//' |
		sed '/^$/d' |
		sed 's/},{/}\n/g; s/^{//; s/}$//'
}

json_obj_get() {
	obj="$1"
	key="$2"
	printf '%s' "$obj" | awk -v key="$key" '
	{
		n = split($0, parts, ",")
		prefix = "\"" key "\":\""
		for (i = 1; i <= n; i++) {
			gsub(/^[[:space:]]*/, "", parts[i])
			if (index(parts[i], prefix) == 1) {
				value = substr(parts[i], length(prefix) + 1)
				sub(/".*/, "", value)
				print value
				exit
			}
		}
	}'
}

json_string_field() {
	obj="$1"
	key="$2"
	printf '%s' "$obj" | awk -v key="$key" '
	BEGIN { pat = "\"" key "\":\"" }
	{
		p = index($0, pat)
		if (!p) exit
		s = substr($0, p + length(pat))
		out = ""
		esc = 0
		for (i = 1; i <= length(s); i++) {
			c = substr(s, i, 1)
			if (esc) {
				if (c == "n") out = out "\n"
				else if (c == "t") out = out " "
				else if (c == "r") out = out ""
				else out = out c
				esc = 0
			} else if (c == "\\") {
				esc = 1
			} else if (c == "\"") {
				print out
				exit
			} else {
				out = out c
			}
		}
	}'
}

json_string_field_after() {
	obj="$1"
	marker="$2"
	key="$3"
	printf '%s' "$obj" | awk -v marker="$marker" -v key="$key" '
	BEGIN { pat = "\"" key "\":\"" }
	{
		m = index($0, marker)
		if (!m) exit
		s = substr($0, m + length(marker))
		p = index(s, pat)
		if (!p) exit
		s = substr(s, p + length(pat))
		out = ""
		esc = 0
		for (i = 1; i <= length(s); i++) {
			c = substr(s, i, 1)
			if (esc) {
				if (c == "n") out = out "\n"
				else if (c == "t") out = out " "
				else if (c == "r") out = out ""
				else out = out c
				esc = 0
			} else if (c == "\\") {
				esc = 1
			} else if (c == "\"") {
				print out
				exit
			} else {
				out = out c
			}
		}
	}'
}

json_number_field_after() {
	obj="$1"
	marker="$2"
	key="$3"
	printf '%s' "$obj" | awk -v marker="$marker" -v key="$key" '
	{
		m = index($0, marker)
		if (!m) exit
		s = substr($0, m + length(marker))
		pat = "\"" key "\":"
		p = index(s, pat)
		if (!p) exit
		s = substr(s, p + length(pat))
		if (match(s, /^-?[0-9]+/))
			print substr(s, RSTART, RLENGTH)
	}'
}

json_chat_id_after() {
	obj="$1"
	marker="$2"
	printf '%s' "$obj" | awk -v marker="$marker" '
	{
		m = index($0, marker)
		if (!m) exit
		s = substr($0, m + length(marker))
		p = index(s, "\"chat\":{")
		if (!p) exit
		s = substr(s, p + length("\"chat\":{"))
		p = index(s, "\"id\":")
		if (!p) exit
		s = substr(s, p + length("\"id\":"))
		if (match(s, /^-?[0-9]+/))
			print substr(s, RSTART, RLENGTH)
	}'
}

json_chat_id_any() {
	obj="$1"
	printf '%s' "$obj" | sed -n 's/.*"chat":{"id":\(-*[0-9][0-9]*\).*/\1/p' | tail -n 1
}

telegram_update_lines() {
	awk '{ printf "%s", $0 }' |
		sed 's/^.*"result":\[//; s/\][^]]*$//' |
		sed 's/},{"update_id"/}\n{"update_id"/g' |
		sed -n '/"update_id":/p'
}

miner_obj_by_index() {
	want="$1"
	i=0
	miner_objects | while IFS= read -r obj; do
		if [ "$i" = "$want" ]; then
			printf '%s\n' "$obj"
			break
		fi
		i=$((i + 1))
	done
}

telegram_status_icon() {
	case "$1" in
		ok) printf '🟢' ;;
		overheat) printf '🔥' ;;
		fan_fault) printf '🌀' ;;
		hash_drop) printf '📉' ;;
		idle) printf '🟡' ;;
		bad_shares) printf '🟠' ;;
		api_down) printf '🔴' ;;
		camera_down) printf '📷' ;;
		*) printf '⚠️' ;;
	esac
}

telegram_status_label() {
	case "$1" in
		ok|OK|RECOVERED) printf 'Норма' ;;
		overheat|Overheat) printf 'Перегрев' ;;
		fan_fault|"Fan fault") printf 'Проблема с вентилятором' ;;
		hash_drop|"Hash drop") printf 'Сильное снижение скорости добычи' ;;
		idle|Idle) printf 'Простой' ;;
		bad_shares|"Bad shares") printf 'Много битых шар' ;;
		api_down|"API down") printf 'Нет связи с API' ;;
		camera_down|"Camera down") printf 'Камера offline' ;;
		AUTO-REBOOT) printf 'Автоперезагрузка' ;;
		"No IP") printf 'Не указан IP' ;;
		*) printf 'Внимание' ;;
	esac
}

button_status_text() {
	case "$1" in
		ok) printf 'ОК' ;;
		overheat) printf 'ЖАРА' ;;
		fan_fault) printf 'ВЕНТ' ;;
		hash_drop) printf 'ДОБЫЧА' ;;
		idle) printf 'СТОП' ;;
		bad_shares) printf 'ШАРЫ' ;;
		api_down) printf 'СВЯЗЬ' ;;
		*) printf 'ВНИМ' ;;
	esac
}

format_hashrate() {
	raw="$1"
	awk -v h="$raw" '
	BEGIN {
		h += 0
		if (h <= 0) printf "нет данных"
		else if (h >= 1000000) printf "%.1f TH/s", h / 1000000
		else if (h >= 1000) printf "%.1f TH/s", h / 1000
		else printf "%.1f GH/s", h
	}'
}

format_temp() {
	awk -v t="$(num_or_zero "$1")" 'BEGIN { if (t > 0) printf "%.1f°C", t; else printf "нет данных" }'
}

format_fan() {
	fan="$1"
	if [ -n "$fan" ] && [ "$fan" != "0" ]; then
		printf '%srpm' "$fan"
	else
		printf 'нет данных'
	fi
}

format_uptime() {
	raw="$(num_or_zero "$1")"
	awk -v s="$raw" '
	BEGIN {
		s = int(s)
		if (s <= 0) {
			printf "нет данных"
			exit
		}
		d = int(s / 86400)
		h = int((s % 86400) / 3600)
		if (d > 0) printf "%dд %dч", d, h
		else if (h > 0) printf "%dч", h
		else printf "<1ч"
	}'
}

compact_miner_metrics() {
	hash_fmt="$(format_hashrate "$1")"
	hash_24h_fmt="$(format_hashrate "$2")"
	bad_fmt="$(format_percent "${3:-0}")"
	temp_fmt="$(format_temp "$4")"
	fan_fmt="$(format_fan "$5")"
	if gt_num "$2" 0; then
		hash_part="${hash_fmt}/${hash_24h_fmt}"
	else
		hash_part="$hash_fmt"
	fi
	printf '⚡️ %s ❌ %s🌡 %s  🌀  %s' "$hash_part" "$bad_fmt" "$temp_fmt" "$fan_fmt"
}

hash_spread_percent() {
	printf '%s' "$1" | tr '/' '\n' |
		awk 'NF && $1+0==$1 && $1+0 > 0 {
			v=$1+0
			if (!seen || v < min) min=v
			if (!seen || v > max) max=v
			seen=1
		}
		END {
			if (!seen || max <= 0) print 0
			else printf "%.1f", ((max-min)*100)/max
		}'
}

nonzero_list_count() {
	printf '%s' "$1" | tr '/' '\n' | awk 'NF && $1+0 > 0 { c++ } END { print c+0 }'
}

miner_recommendations() {
	obj="$1"
	status="$(json_obj_get "$obj" status)"
	temp="$(json_obj_get "$obj" temp)"
	bad_pct="$(json_obj_get "$obj" bad_pct)"
	fan_min="$(json_obj_get "$obj" fan_min)"
	fan_count="$(json_obj_get "$obj" fan_count)"
	hw_errors="$(json_obj_get "$obj" hw_errors)"
	board_hw="$(json_obj_get "$obj" board_hw)"
	board_hashrates="$(json_obj_get "$obj" board_hashrates)"
	pools="$(json_obj_get "$obj" pools)"
	section="$(json_obj_get "$obj" section)"
	max_temp="$(section_cfg "$section" max_temp "$(cfg max_temp 85)")"
	min_fan="$(cfg min_fan_rpm 1000)"
	bad_limit="$(cfg bad_share_percent 3)"
	spread="$(hash_spread_percent "$board_hashrates")"
	board_hw_bad="$(nonzero_list_count "$board_hw")"
	notes=""

	if [ "$status" = "api_down" ]; then
		notes="$notes
- Нет API: проверь питание, сеть, IP и порт 4028."
	fi
	if gt_num "$temp" "$max_temp" || [ "$status" = "overheat" ]; then
		notes="$notes
- Перегрев: temp=${temp}C, лимит=${max_temp}C. Проверь продув, пыль, температуру помещения и режим разгона."
	fi
	if gt_num "$fan_count" 0 && gt_num "$min_fan" "$fan_min"; then
		notes="$notes
- Вентилятор: минимум ${fan_min}rpm ниже лимита ${min_fan}rpm. Проверь fan/разъём/питание."
	fi
	if gt_num "$bad_pct" "$bad_limit"; then
		notes="$notes
- Битые шары: ${bad_pct}% выше лимита ${bad_limit}%. Проверь пул, сеть, частоты и стабильность плат."
	fi
	if gt_num "$hw_errors" 0 || gt_num "$board_hw_bad" 0; then
		notes="$notes
- HW ошибки: есть ошибки по платам. Проверь конкретную плату, питание, частоты и охлаждение."
	fi
	if gt_num "$spread" 20; then
		notes="$notes
- Разброс скорости добычи по платам: ${spread}%. Возможна просадка одной платы или перегрев."
	fi
	printf '%s' "$pools" | grep -Eiq 'dead|fail|offline' && notes="$notes
- Пул: есть признаки Dead/Fail/Offline. Проверь pool URL, DNS и сеть."

	if [ -z "$notes" ]; then
		echo "- Критичных рекомендаций нет. Наблюдай температуру, не отгаданные блоки и вентиляторы."
	else
		printf '%s\n' "$notes"
	fi
}

telegram_miner_detail() {
	idx="$1"
	obj="$(miner_obj_by_index "$idx")"
	[ -n "$obj" ] || {
		echo "ASIC не найден"
		return 1
	}
	name="$(json_obj_get "$obj" name)"
	ip="$(json_obj_get "$obj" ip)"
	model="$(json_obj_get "$obj" model)"
	status="$(json_obj_get "$obj" status)"
	reason="$(json_obj_get "$obj" reason)"
	temp="$(json_obj_get "$obj" temp)"
	hashrate="$(json_obj_get "$obj" hashrate)"
	hashrate_24h="$(json_obj_get "$obj" hashrate_24h)"
	temp_avg_24h="$(json_obj_get "$obj" temp_avg_24h)"
	temp_max_24h="$(json_obj_get "$obj" temp_max_24h)"
	fan_min_24h="$(json_obj_get "$obj" fan_min_24h)"
	bad_avg_24h="$(json_obj_get "$obj" bad_avg_24h)"
	bad_max_24h="$(json_obj_get "$obj" bad_max_24h)"
	accepted="$(json_obj_get "$obj" accepted)"
	accepted_today="$(json_obj_get "$obj" accepted_today)"
	accepted_yday_same="$(json_obj_get "$obj" accepted_yday_same)"
	accepted_vs_yday_pct="$(json_obj_get "$obj" accepted_vs_yday_pct)"
	rejected="$(json_obj_get "$obj" rejected)"
	bad_pct="$(json_obj_get "$obj" bad_pct)"
	hw_errors="$(json_obj_get "$obj" hw_errors)"
	fan_rpm="$(json_obj_get "$obj" fan_rpm)"
	fan_min="$(json_obj_get "$obj" fan_min)"
	board_temps="$(json_obj_get "$obj" board_temps)"
	chip_temps="$(json_obj_get "$obj" chip_temps)"
	board_hashrates="$(json_obj_get "$obj" board_hashrates)"
	board_chips="$(json_obj_get "$obj" board_chips)"
	board_status="$(json_obj_get "$obj" board_status)"
	board_hw="$(json_obj_get "$obj" board_hw)"
	uptime="$(json_obj_get "$obj" uptime)"
	pools="$(json_obj_get "$obj" pools)"
	autotune="$(json_obj_get "$obj" autotune)"
	ping="$(json_obj_get "$obj" ping)"
	icon="$(telegram_status_icon "$status")"
	label="$(telegram_status_label "$status")"
	reason_label="$(telegram_status_label "$reason")"
	hash_fmt="$(format_hashrate "$hashrate")"
	hash_24h_fmt="$(format_hashrate "$hashrate_24h")"
	accepted_delta_text="нет данных"
	[ -n "$accepted_vs_yday_pct" ] && accepted_delta_text="${accepted_vs_yday_pct}%"
	temp_fmt="$(format_temp "$temp")"
	fan_fmt="$(format_fan "$fan_min")"
	uptime_fmt="$(format_uptime "$uptime")"
	cat <<EOF
${icon} ${name}
${ip} · ${model}

📌 Статус: ${label} (${reason_label})
⚡️ Скорость добычи: ${hash_fmt}
📊 Средняя за 24ч: ${hash_24h_fmt}
📈 24ч: temp ср. $(format_temp "$temp_avg_24h") / max $(format_temp "$temp_max_24h") · fan min $(format_fan "$fan_min_24h")
📉 Битые шары 24ч: ср. $(format_percent "$bad_avg_24h") / пик $(format_percent "$bad_max_24h")
🌡 Температура: ${temp_fmt}
🌀 Вентиляторы: ${fan_rpm:-нет данных} · мин. ${fan_fmt}
✅ Разгадал блоков: ${accepted:-0}   ❌ Не отгадал: ${rejected:-0}
📅 Сегодня шар: ${accepted_today:-0} · вчера к этому времени: ${accepted_yday_same:-0} · ${accepted_delta_text}
🧮 Битые шары: ${bad_pct}%   HW: ${hw_errors}
🌐 Сеть/API: ${ping:-нет данных}
⏱ Аптайм: ${uptime_fmt}

Платы и чипы
🌡 Платы: ${board_temps:-нет данных}
🔥 Чипы: ${chip_temps:-нет данных}
⚡️ Скорость по платам: ${board_hashrates:-нет данных}
🧩 Чипы: ${board_chips:-нет данных}
📋 Состояние: ${board_status:-нет данных}
🧯 HW по платам: ${board_hw:-нет данных}

Пулы и режим
🏁 Пулы: ${pools:-нет данных}
🎛 Автотюн/разгон: ${autotune:-нет данных}

Рекомендации
$(miner_recommendations "$obj")
EOF
}

telegram_status_menu() {
	chat_id="$1"
	message_id="$2"
	updated="$(status_updated)"
	panel_time="$(date '+%H:%M:%S')"
	menu_suffix="$(safe_id "$$-${message_id:-new}-$(date +%s)")"
	menu_file="$(mktemp "$RUNDIR/tg-menu.XXXXXX" 2>/dev/null || printf '%s' "$RUNDIR/tg-menu-$menu_suffix")"
	miner_objects >"$menu_file"
	ok_body=""
	issue_body=""
	camera_body=""
	total=0
	ok_count=0
	issue_count=0
	camera_total=0
	camera_down_count=0
	down_count=0
	hot_count=0
	fan_fault_count=0
	max_seen=0
	min_fan_seen=0
	markup='{"inline_keyboard":[[{"text":"🔄 Обновить","callback_data":"refresh"}]'
	i=0
	while IFS= read -r obj; do
		name="$(json_obj_get "$obj" name)"
		ip="$(json_obj_get "$obj" ip)"
		status="$(json_obj_get "$obj" status)"
		temp="$(json_obj_get "$obj" temp)"
		hashrate="$(json_obj_get "$obj" hashrate)"
		hashrate_24h="$(json_obj_get "$obj" hashrate_24h)"
		bad_pct="$(json_obj_get "$obj" bad_pct)"
		fan_min="$(json_obj_get "$obj" fan_min)"
		uptime="$(json_obj_get "$obj" uptime)"
		icon="$(telegram_status_icon "$status")"
		label="$(telegram_status_label "$status")"
		short="$(button_status_text "$status")"
		linked_name="$(miner_link "$name" "$ip")"
		total=$((total + 1))
		row="${icon} ${linked_name} · ${label} · ⏱ $(format_uptime "$uptime")
$(compact_miner_metrics "$hashrate" "$hashrate_24h" "$bad_pct" "$temp" "$fan_min")
"
		case "$status" in
			ok)
				ok_count=$((ok_count + 1))
				ok_body="${ok_body}${row}"
				;;
			api_down)
				issue_count=$((issue_count + 1))
				down_count=$((down_count + 1))
				issue_body="${issue_body}${row}"
				;;
			overheat)
				issue_count=$((issue_count + 1))
				hot_count=$((hot_count + 1))
				issue_body="${issue_body}${row}"
				;;
			fan_fault)
				issue_count=$((issue_count + 1))
				fan_fault_count=$((fan_fault_count + 1))
				issue_body="${issue_body}${row}"
				;;
			*)
				issue_count=$((issue_count + 1))
				issue_body="${issue_body}${row}"
				;;
		esac
		if gt_num "$temp" "$max_seen"; then max_seen="$temp"; fi
		if [ "$fan_min" != "0" ] && { [ "$min_fan_seen" = "0" ] || gt_num "$min_fan_seen" "$fan_min"; }; then min_fan_seen="$fan_min"; fi
		btn_text="$(printf 'ℹ️ %s %s' "$short" "$name" | json_escape)"
		reboot_text="$(printf '🔁 %s' "$name" | json_escape)"
		markup="${markup},[{\"text\":\"$btn_text\",\"callback_data\":\"detail:$i\"},{\"text\":\"$reboot_text\",\"callback_data\":\"reboot:$i\"}]"
		i=$((i + 1))
	done <"$menu_file"
	rm -f "$menu_file"
	camera_file="$menu_file.cameras"
	camera_objects >"$camera_file"
	while IFS= read -r obj; do
		[ -n "$obj" ] || continue
		name="$(json_obj_get "$obj" name)"
		ip="$(json_obj_get "$obj" ip)"
		status="$(json_obj_get "$obj" status)"
		ping="$(json_obj_get "$obj" ping)"
		icon="$(telegram_status_icon "$status")"
		label="$(telegram_status_label "$status")"
		linked_name="$(miner_link "$name" "$ip")"
		camera_total=$((camera_total + 1))
		[ "$status" = "camera_down" ] && camera_down_count=$((camera_down_count + 1))
		camera_body="${camera_body}${icon} ${linked_name} · ${label}
   🌐 $(format_ping_alert "$ping")
"
	done <"$camera_file"
	rm -f "$camera_file"
	markup="${markup}]}"
	max_temp_fmt="$(format_temp "$max_seen")"
	min_fan_fmt="$(format_fan "$min_fan_seen")"
	[ -n "$issue_body" ] || issue_body="   Нет проблем
"
	[ -n "$ok_body" ] || ok_body="   Нет ASIC в норме
"
	[ -n "$camera_body" ] || camera_body="   Камеры не добавлены
"
	text="📊 ASIC ${updated:-unknown} · панель ${panel_time}
Итог: 🟢 ${ok_count}/${total} · 🔴 ${issue_count} · 📷 ${camera_down_count}/${camera_total} · max ${max_temp_fmt} · min fan ${min_fan_fmt}

🚨 Требуют внимания
${issue_body}
✅ В норме
${ok_body}
📷 IP-камеры
${camera_body}
Кнопки: ℹ️ детали, 🔁 перезагрузка."
	if [ -n "$message_id" ]; then
		if telegram_edit_markup "$text" "$markup" "$chat_id" "$message_id" html; then
			log "telegram menu edited chat=$chat_id message=$message_id miners=$total issues=$issue_count cameras=$camera_total"
			return 0
		else
			log "telegram menu edit failed chat=$chat_id message=$message_id"
			if telegram_send "$text" "$chat_id" html; then
				log "telegram menu fallback sent chat=$chat_id miners=$total issues=$issue_count cameras=$camera_total"
				return 0
			fi
			log "telegram menu fallback failed chat=$chat_id"
			return 1
		fi
	else
		if telegram_send_markup "$text" "$markup" "$chat_id" html; then
			log "telegram menu sent chat=$chat_id miners=$total issues=$issue_count cameras=$camera_total"
			return 0
		else
			log "telegram menu send failed chat=$chat_id"
			if telegram_send "$text" "$chat_id" html; then
				log "telegram menu fallback sent chat=$chat_id miners=$total issues=$issue_count cameras=$camera_total"
				return 0
			fi
			log "telegram menu fallback failed chat=$chat_id"
			return 1
		fi
	fi
}

telegram_help_text() {
	cat <<'EOF'
ASIC Watchdog

/menu - главное меню
/status - панель статуса с кнопками
/miners - список ASIC
/pooltest btc 300 10 - тест BTC пулов ViaBTC
/pooltest zec 300 10 - тест ZEC пулов ViaBTC
/reboot имя_или_ip - ручная перезагрузка ASIC
/chatid - показать ID группы
EOF
}

telegram_main_menu() {
	chat_id="$1"
	message_id="$2"
	msg="ASIC Watchdog

Выбери действие:"
	markup='{"inline_keyboard":[[{"text":"📊 Статус","callback_data":"menu_status"},{"text":"🔄 Обновить","callback_data":"refresh"}],[{"text":"⛏ ASIC","callback_data":"menu_miners"},{"text":"₿ BTC пулы","callback_data":"pooltest:btc"}],[{"text":"ZEC пулы","callback_data":"pooltest:zec"},{"text":"🌐 Все пулы","callback_data":"pooltest:all"}],[{"text":"❓ Помощь","callback_data":"menu_help"}]]}'
	if [ -n "$message_id" ]; then
		telegram_edit_markup "$msg" "$markup" "$chat_id" "$message_id" || telegram_send "$msg" "$chat_id"
	else
		telegram_send_markup "$msg" "$markup" "$chat_id" || telegram_send "$msg" "$chat_id"
	fi
}

telegram_pooltest_async() {
	chat_id="$1"
	coin="$2"
	duration="${3:-$(cfg pool_test_duration 300)}"
	interval="${4:-$(cfg pool_test_interval 10)}"
	telegram_send "Тест пулов запущен: ${coin}, общий лимит ${duration}с, интервал ${interval}с. Итог пришлю сюда." "$chat_id"
	(
		out="$(pool_test "$coin" "$duration" "$interval" 2>&1)"
		telegram_send "$out" "$chat_id"
	) >/dev/null 2>&1 &
}

telegram_heartbeat() {
	interval="$(cfg telegram_heartbeat_interval 0)"
	[ "$interval" -gt 0 ] 2>/dev/null || return 0
	telegram_enabled || return 0
	current="$(now)"
	file="$RUNDIR/telegram-heartbeat.last"
	last="$(cat "$file" 2>/dev/null || echo 0)"
	[ $((current - last)) -ge "$interval" ] || return 0
	echo "$current" >"$file"

	total=0
	ok_count=0
	issue_count=0
	menu_file="$(mktemp "$RUNDIR/tg-heartbeat.XXXXXX" 2>/dev/null || printf '%s' "$RUNDIR/tg-heartbeat-$$")"
	miner_objects >"$menu_file"
	while IFS= read -r obj; do
		[ -n "$obj" ] || continue
		total=$((total + 1))
		status="$(json_obj_get "$obj" status)"
		if [ "$status" = "ok" ]; then
			ok_count=$((ok_count + 1))
		else
			issue_count=$((issue_count + 1))
		fi
	done <"$menu_file"
	rm -f "$menu_file"

	updated="$(status_updated)"
	age="$(status_age)"
	msg="🟢 ASIC Watchdog · Telegram OK
ASIC: ${ok_count}/${total} в норме · проблем ${issue_count}
Статус: ${updated:-нет данных} · возраст ${age} сек"
	if telegram_send "$msg" "" html; then
		log "telegram heartbeat sent chat=$(cfg chat_id) miners=$total issues=$issue_count age=${age}s"
	else
		log "telegram heartbeat failed chat=$(cfg chat_id)"
	fi
}

telegram_handle_callback() {
	chat_id="$1"
	data="$2"
	callback_id="$3"
	message_id="$4"
	allowed="$(cfg chat_id)"
	[ "$chat_id" = "$allowed" ] || {
		telegram_answer_callback "$callback_id" "Нет доступа"
		return 0
	}
	case "$data" in
		menu)
			telegram_answer_callback "$callback_id" "Меню"
			telegram_main_menu "$chat_id" "$message_id"
			;;
		menu_status|menu_miners)
			telegram_answer_callback "$callback_id" "Открываю статус"
			telegram_status_menu "$chat_id" "$message_id"
			;;
		menu_help)
			telegram_answer_callback "$callback_id" "Помощь"
			markup='{"inline_keyboard":[[{"text":"⬅️ Меню","callback_data":"menu"},{"text":"📊 Статус","callback_data":"menu_status"}]]}'
			telegram_edit_markup "$(telegram_help_text)" "$markup" "$chat_id" "$message_id"
			;;
		pooltest:*)
			coin="${data#pooltest:}"
			telegram_answer_callback "$callback_id" "Запускаю тест $coin"
			telegram_pooltest_async "$chat_id" "$coin"
			;;
		refresh)
			telegram_answer_callback "$callback_id" "Обновляю..."
			telegram_status_menu "$chat_id" "$message_id"
			("$0" run-once >/dev/null 2>&1; telegram_status_menu "$chat_id" "$message_id") >/dev/null 2>&1 &
			;;
		detail:*)
			idx="${data#detail:}"
			telegram_answer_callback "$callback_id" "Открываю детали"
			markup="{\"inline_keyboard\":[[{\"text\":\"🔄 Обновить список\",\"callback_data\":\"refresh\"},{\"text\":\"🔁 Перезагрузка\",\"callback_data\":\"reboot:$idx\"}]]}"
			telegram_send_markup "$(telegram_miner_detail "$idx")" "$markup" "$chat_id"
			;;
		reboot:*)
			idx="${data#reboot:}"
			obj="$(miner_obj_by_index "$idx")"
			if [ -z "$obj" ]; then
				telegram_answer_callback "$callback_id" "ASIC не найден"
				return 0
			fi
			name="$(json_obj_get "$obj" name)"
			ip="$(json_obj_get "$obj" ip)"
			telegram_answer_callback "$callback_id" "Подтверди перезагрузку"
			markup="{\"inline_keyboard\":[[{\"text\":\"✅ Да, перезагрузить\",\"callback_data\":\"confirm_reboot:$idx\"},{\"text\":\"✖️ Отмена\",\"callback_data\":\"cancel\"}]]}"
			telegram_send_markup "🔁 Перезагрузить $name ($ip)?" "$markup" "$chat_id"
			;;
		confirm_reboot:*)
			idx="${data#confirm_reboot:}"
			obj="$(miner_obj_by_index "$idx")"
			if [ -z "$obj" ]; then
				telegram_answer_callback "$callback_id" "ASIC не найден"
				return 0
			fi
			name="$(json_obj_get "$obj" name)"
			ip="$(json_obj_get "$obj" ip)"
			section="$(json_obj_get "$obj" section)"
			target="${section:-$name}"
			telegram_answer_callback "$callback_id" "Отправляю команду..."
			out="$(reboot_miner "$target" 2>&1)"
			rc=$?
			if [ "$rc" -eq 0 ]; then
				telegram_send "✅ Команда перезагрузки отправлена: $name
$out" "$chat_id"
			else
				telegram_send "❌ Не удалось перезагрузить $name
$out" "$chat_id"
			fi
			;;
		cancel)
			telegram_answer_callback "$callback_id" "Отменено"
			;;
	esac
}

telegram_handle_command() {
	chat_id="$1"
	text="$2"
	allowed="$(cfg chat_id)"
	cmd="$(printf '%s' "$text" | awk '{ print $1 }')"
	cmd_base="$(printf '%s' "$cmd" | sed 's#^\\*/*##; s#@.*##; s#[^A-Za-z0-9_-].*$##')"
	args="$(printf '%s' "$text" | sed 's/^[^ ][^ ]*[ ]*//')"

	case "$cmd_base" in
		chatid)
			telegram_send "Chat ID: $chat_id
Укажи это значение в LuCI -> Services -> ASIC Watchdog -> Chat / Group ID." "$chat_id"
			return 0
			;;
	esac

	[ "$chat_id" = "$allowed" ] || {
		log "telegram command ignored chat=$chat_id allowed=$allowed cmd=$cmd_base"
		return 0
	}
	log "telegram command chat=$chat_id cmd=$cmd_base"

	case "$cmd_base" in
		menu)
			telegram_main_menu "$chat_id"
			;;
		status)
			telegram_status_menu "$chat_id"
			;;
		miners)
			telegram_status_menu "$chat_id"
			;;
		reboot)
			target="$args"
			if [ -n "$target" ]; then
				out="$(reboot_miner "$target" 2>&1)"
				telegram_send "$out" "$chat_id"
			else
				telegram_send "Формат: /reboot имя_или_ip" "$chat_id"
			fi
			;;
		pooltest)
			set -- $args
			coin="${1:-all}"
			duration="${2:-$(cfg pool_test_duration 300)}"
			interval="${3:-$(cfg pool_test_interval 10)}"
			telegram_pooltest_async "$chat_id" "$coin" "$duration" "$interval"
			;;
		help)
			telegram_send "$(telegram_help_text)" "$chat_id"
			;;
		start)
			telegram_main_menu "$chat_id"
			;;
		help_legacy_disabled)
			telegram_send "/status - мониторинг с кнопками
/miners - тот же список ASIC
/reboot имя_или_ip - перезагрузка вручную
/chatid - показать ID этой группы" "$chat_id"
			;;
	esac
}

telegram_poll_unlock() {
	rm -f "$TG_POLL_LOCK_DIR/pid" 2>/dev/null || true
	rmdir "$TG_POLL_LOCK_DIR" 2>/dev/null || true
}

telegram_poll_lock() {
	if mkdir "$TG_POLL_LOCK_DIR" 2>/dev/null; then
		echo "$$ $(now)" >"$TG_POLL_LOCK_DIR/pid"
		return 0
	fi
	lock_line="$(cat "$TG_POLL_LOCK_DIR/pid" 2>/dev/null || true)"
	old_pid="$(printf '%s' "$lock_line" | awk '{ print $1 }')"
	old_started="$(printf '%s' "$lock_line" | awk '{ print $2 }')"
	current="$(now)"
	lock_age=0
	[ -n "$old_started" ] && lock_age=$((current - old_started))
	lock_timeout=$(( $(telegram_timeout) + 10 ))
	[ "$lock_timeout" -lt 20 ] && lock_timeout=20
	if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null && [ "$lock_age" -lt "$lock_timeout" ]; then
		log_limited telegram_poll_busy 30 "telegram poll already running age=${lock_age}s"
		return 1
	fi
	log_limited telegram_poll_stale 60 "telegram poll lock stale pid=${old_pid:-unknown} age=${lock_age}s, clearing"
	[ -n "$old_pid" ] && kill "$old_pid" 2>/dev/null || true
	rm -rf "$TG_POLL_LOCK_DIR" 2>/dev/null || true
	if mkdir "$TG_POLL_LOCK_DIR" 2>/dev/null; then
		echo "$$ $(now)" >"$TG_POLL_LOCK_DIR/pid"
		return 0
	fi
	return 1
}

telegram_poll() {
	telegram_ready || return 0
	telegram_poll_lock || return 0
	offset="$(cat "$TG_OFFSET_FILE" 2>/dev/null || echo 0)"
	json="$(telegram_request "getUpdates" "timeout=0&offset=$offset")" || {
		log_limited telegram_poll_failed 60 "telegram poll failed"
		telegram_poll_unlock
		return 0
	}
	if [ -z "$json" ]; then
		telegram_poll_unlock
		return 0
	fi
	case "$json" in
		*'"ok":true'*) ;;
		*)
			telegram_note_failure poll_rejected
			log_limited telegram_poll_rejected 60 "telegram poll rejected: $(printf '%s' "$json" | cut -c1-180)"
			telegram_poll_unlock
			return 0
			;;
	esac

	printf '%s' "$json" | telegram_update_lines | while IFS= read -r item; do
		update_id="$(printf '%s' "$item" | sed -n 's/.*"update_id":\([0-9][0-9]*\).*/\1/p')"
		callback_data="$(json_string_field_after "$item" '"callback_query":' data)"
		callback_id="$(json_string_field_after "$item" '"callback_query":' id)"
		[ -n "$callback_data" ] || callback_data="$(json_string_field "$item" data)"
		if [ -n "$callback_data" ]; then
			chat_id="$(json_chat_id_after "$item" '"callback_query":')"
			message_id="$(json_number_field_after "$item" '"callback_query":' message_id)"
			[ -n "$chat_id" ] || chat_id="$(json_chat_id_after "$item" '"message":')"
			[ -n "$chat_id" ] || chat_id="$(json_chat_id_after "$item" '"channel_post":')"
			[ -n "$chat_id" ] || chat_id="$(json_chat_id_any "$item")"
			[ -n "$message_id" ] || message_id="$(json_number_field_after "$item" '' message_id)"
			text=""
		else
			chat_id="$(json_chat_id_after "$item" '"message":')"
			message_id=""
			text="$(json_string_field_after "$item" '"message":' text)"
			if [ -z "$chat_id$text" ]; then
				chat_id="$(json_chat_id_after "$item" '"edited_message":')"
				message_id=""
				text="$(json_string_field_after "$item" '"edited_message":' text)"
			fi
			if [ -z "$chat_id$text" ]; then
				chat_id="$(json_chat_id_after "$item" '"channel_post":')"
				message_id=""
				text="$(json_string_field_after "$item" '"channel_post":' text)"
			fi
			if [ -z "$chat_id$text" ]; then
				chat_id="$(json_chat_id_after "$item" '"edited_channel_post":')"
				message_id=""
				text="$(json_string_field_after "$item" '"edited_channel_post":' text)"
			fi
			[ -n "$chat_id" ] || chat_id="$(json_chat_id_any "$item")"
			[ -n "$text" ] || text="$(json_string_field "$item" text)"
		fi
		[ -n "$update_id" ] && echo $((update_id + 1)) >"$TG_OFFSET_FILE"
		if [ -n "$chat_id" ] && [ -n "$callback_data" ]; then
			telegram_handle_callback "$chat_id" "$callback_data" "$callback_id" "$message_id"
		elif [ -n "$chat_id" ] && [ -n "$text" ]; then
			telegram_handle_command "$chat_id" "$text"
		elif [ -n "$update_id" ]; then
			log "telegram update ignored update_id=$update_id chat=${chat_id:-unknown} no_text_or_callback raw=$(printf '%s' "$item" | cut -c1-180)"
		fi
	done
	telegram_poll_unlock
}

daemon_is_owner() {
	owner="$(cat "$DAEMON_LOCK_DIR/pid" 2>/dev/null || true)"
	[ "$owner" = "$$" ]
}

daemon_try_lock() {
	if mkdir "$DAEMON_LOCK_DIR" 2>/dev/null; then
		echo "$$" >"$DAEMON_LOCK_DIR/pid"
		return 0
	fi
	lock_pid="$(cat "$DAEMON_LOCK_DIR/pid" 2>/dev/null || true)"
	if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
		return 1
	fi
	log "removing stale daemon lock pid=${lock_pid:-unknown}"
	rm -rf "$DAEMON_LOCK_DIR" 2>/dev/null || true
	if mkdir "$DAEMON_LOCK_DIR" 2>/dev/null; then
		echo "$$" >"$DAEMON_LOCK_DIR/pid"
		return 0
	fi
	return 1
}

daemon_wait_for_lock() {
	if ! daemon_try_lock; then
		lock_pid="$(cat "$DAEMON_LOCK_DIR/pid" 2>/dev/null || true)"
		log "daemon already running pid=${lock_pid:-unknown}, exiting duplicate"
		exit 0
	fi
	echo "$$" >"$DAEMON_PID_FILE"
	log "daemon started"
}

daemon_reap_duplicates() {
	owner="$(cat "$DAEMON_LOCK_DIR/pid" 2>/dev/null || true)"
	[ -n "$owner" ] || owner="$$"
	for pid in $(ps w | awk '/asic-watchdog\} \/bin\/sh \/usr\/bin\/asic-watchdog daemon/ { print $1 }'); do
		[ "$pid" = "$owner" ] && continue
		log_limited "daemon_duplicate_$pid" 60 "stopping duplicate daemon pid=$pid owner=$owner"
		kill "$pid" 2>/dev/null || true
	done
}

daemon_cleanup() {
	trap - INT TERM EXIT
	if daemon_is_owner; then
		rm -rf "$DAEMON_LOCK_DIR" "$DAEMON_PID_FILE"
	fi
	exit 0
}

daemon() {
	trap 'daemon_cleanup' INT TERM EXIT
	daemon_wait_for_lock
	daemon_reap_duplicates
	last_check=0
	while true; do
		if ! daemon_is_owner; then
			log "daemon lost lock, exiting duplicate pid=$$"
			exit 0
		fi
		if [ "$(cfg enabled 1)" = "1" ]; then
			daemon_reap_duplicates
			telegram_poll
			telegram_heartbeat
			current="$(now)"
			interval="$(cfg interval 60)"
			stale_timeout="$(status_stale_timeout)"
			age="$(status_age)"
			if [ "$age" -ge "$stale_timeout" ]; then
				log_limited status_stale 60 "status stale age=${age}s timeout=${stale_timeout}s, forcing check"
				run_once_async
				last_check="$current"
			elif [ $((current - last_check)) -ge "$interval" ]; then
				run_once_async
				last_check="$current"
			fi
		fi
		sleep "$(cfg telegram_poll_interval 5)"
	done
}

case "${1:-status-json}" in
	daemon) daemon ;;
	run-once) run_once ;;
	status-json) status_json ;;
	status-text) status_text ;;
	miners) miners_text ;;
	pool-test) shift; pool_test "${1:-all}" "${2:-$(cfg pool_test_duration 300)}" "${3:-$(cfg pool_test_interval 10)}" "${4:-$(cfg pool_test_timeout 5)}" ;;
	telegram-test) if telegram_send "[TEST] ASIC Watchdog Telegram delivery check
Router: $(cfg router_label "OpenWrt ASIC Watchdog")
Chat: $(cfg chat_id)"; then echo "telegram test sent to $(cfg chat_id)"; else echo "telegram test failed for $(cfg chat_id)"; exit 1; fi ;;
	telegram-menu) if telegram_main_menu "$(cfg chat_id)"; then echo "telegram menu sent to $(cfg chat_id)"; else echo "telegram menu failed for $(cfg chat_id)"; exit 1; fi ;;
	telegram-status) if telegram_status_menu "$(cfg chat_id)"; then echo "telegram status sent to $(cfg chat_id)"; else echo "telegram status failed for $(cfg chat_id)"; exit 1; fi ;;
	telegram-poll) telegram_poll; echo "telegram poll done" ;;
	reboot) shift; reboot_miner "$1" ;;
	*) echo "Использование: $0 daemon|run-once|status-json|status-text|miners|telegram-test|telegram-menu|telegram-poll|reboot <имя|ip>" >&2; exit 1 ;;
esac
